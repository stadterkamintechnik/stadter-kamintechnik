---
import "../styles/global.css";
import FaviconHead from "../components/layout/FaviconHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stadter Kamintechnik",
  description = "Schornstein- und Abgassysteme für Wohnhäuser, Gewerbe und Industrie.",
} = Astro.props;

const isStaging = import.meta.env.STAGING === "true";
const isDev = import.meta.env.DEV;

const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
  "frame-src 'self' https://www.youtube-nocookie.com https://consentcdn.cookiebot.com",
  "img-src 'self' data: https://consent.cookiebot.com https://consentcdn.cookiebot.com https://imgsct.cookiebot.com",
  "font-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com",
  "connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com",
  "manifest-src 'self'",
  "media-src 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    {!isDev && (
      <meta
        http-equiv="Content-Security-Policy"
        content={contentSecurityPolicy}
      />
    )}

    {!isDev && (
      <script
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid="7e723e2d-77ba-40c5-a196-4850ffe2c425"
        data-blockingmode="auto"
        type="text/javascript"
        is:inline
      ></script>
    )}

    {isStaging && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <FaviconHead />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
