---
import "../styles/global.css";
import FaviconHead from "../components/layout/FaviconHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stadter Kamintechnik",
  description = "Schornstein- und Abgassysteme für Wohnhäuser, Gewerbe und Industrie.",
} = Astro.props;

const isStaging = import.meta.env.STAGING === "true";
const isDev = import.meta.env.DEV;

const canonicalUrl = new URL(
  Astro.url.pathname,
  "https://stadter-kamin.de",
).toString();

const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
  "frame-src 'self' https://www.youtube-nocookie.com https://consentcdn.cookiebot.com https://www.googletagmanager.com",
  "img-src 'self' data: https://consent.cookiebot.com https://consentcdn.cookiebot.com https://imgsct.cookiebot.com https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com",
  "font-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://www.googletagmanager.com",
  "connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com",
  "manifest-src 'self'",
  "media-src 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {!isDev && (
      <meta
        http-equiv="Content-Security-Policy"
        content={contentSecurityPolicy}
      />
    )}

    {!isDev && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
          window.dataLayer.push(arguments);
        }

        gtag("consent", "default", {
          ad_storage: "denied",
          analytics_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          wait_for_update: 500,
        });
      </script>
    )}

    {!isDev && (
      <script
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid="7e723e2d-77ba-40c5-a196-4850ffe2c425"
        data-blockingmode="auto"
        type="text/javascript"
        is:inline
      ></script>
    )}

    {!isDev && (
      <script is:inline>
        (function(w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({
            "gtm.start": new Date().getTime(),
            event: "gtm.js",
          });

          var f = d.getElementsByTagName(s)[0];
          var j = d.createElement(s);
          var dl = l !== "dataLayer" ? "&l=" + l : "";

          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;

          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-KCDWB7D3");
      </script>
    )}

    {isStaging && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <FaviconHead />
    <title>{title}</title>
  </head>

  <body>
    {!isDev && (
      <noscript>
        <iframe
          src="https://www.googletagmanager.com/ns.html?id=GTM-KCDWB7D3"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
