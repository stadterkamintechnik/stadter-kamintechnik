---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectContent from "../../components/reference/ProjectContent.astro";
import ProjectFacts from "../../components/reference/ProjectFacts.astro";
import ProjectCTA from "../../components/reference/ProjectCTA.astro";

const contentSections = [
  {
    kicker: "Die Ausgangssituation",
    title: "Der bestehende Kamin war für den sicheren Betrieb des Kaminofens nicht hoch genug.",
    paragraphs: [
      "Bei einem Wohnhaus in Pegnitz sollte ein bestehender Kaminofen weiter betrieben werden. Dafür musste geprüft werden, ob die vorhandene Schornsteinhöhe die aktuellen Anforderungen an die Ableitung der Abgase erfüllt.",
      "Die Berechnung zeigte, dass der vorhandene Schornstein verlängert werden musste.",
    ],
  },
  {
    kicker: "Die Planung",
    title: "Berechnung der erforderlichen Schornsteinhöhe nach VDI 3781 Blatt 4.",
    paragraphs: [
      "Die erforderliche Mündungshöhe wurde anhand der Gebäudesituation und der maßgeblichen Ableitbedingungen nach VDI 3781 Blatt 4 ermittelt.",
      "Auf Grundlage dieser Berechnung wurde eine passende doppelwandige Kaminverlängerung aus Edelstahl vorgesehen.",
    ],
  },
  {
    kicker: "Die Umsetzung",
    title: "Doppelwandige Edelstahl-Kaminverlängerung auf dem bestehenden Schornstein.",
    paragraphs: [
      "Die Kaminverlängerung wurde auf dem vorhandenen Schornsteinkopf montiert und fachgerecht befestigt. Der Bestandsschornstein konnte dabei vollständig erhalten bleiben.",
      "Die Montage wurde innerhalb eines halben Arbeitstages abgeschlossen.",
    ],
    points: [
      "Berechnung der erforderlichen Schornsteinhöhe nach VDI 3781 Blatt 4",
      "Auswahl einer passenden doppelwandigen Edelstahl-Kaminverlängerung",
      "Montage auf dem vorhandenen Schornsteinkopf",
      "Fachgerechte Befestigung und Ausrichtung",
      "Vorbereitung für den sicheren Weiterbetrieb des Kaminofens",
    ],
  },
  {
    kicker: "Das Ergebnis",
    title: "Der bestehende Kaminofen kann weiter betrieben werden.",
    paragraphs: [
      "Durch die berechnete und montierte Kaminverlängerung wurde die erforderliche Schornsteinhöhe hergestellt.",
      "Damit steht für den bestehenden Kaminofen wieder eine passende und dauerhaft nutzbare Abgasführung zur Verfügung.",
    ],
  },
];

const facts = [
  { label: "Projekt", value: "Kaminverlängerung für bestehenden Kaminofen" },
  { label: "Gebäude", value: "Wohnhaus / Bestand" },
  { label: "Standort", value: "Pegnitz" },
  { label: "Feuerstätte", value: "Kaminofen" },
  { label: "System", value: "Doppelwandige Edelstahl-Kaminverlängerung" },
  { label: "Höhenauslegung", value: "VDI 3781 Blatt 4" },
  { label: "Montagezeit", value: "0,5 Arbeitstage" },
];

const galleryImages = [
  {
    src: "/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/kaminofen-pegnitz.webp",
    alt: "Bestehender Kaminofen in einem Wohnhaus in Pegnitz",
    caption: "Der vorhandene Kaminofen konnte nach der Anpassung der Schornsteinhöhe weiter betrieben werden.",
    format: "portrait",
  },
  {
    src: "/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/vdi-3781-rezirkulationszone.webp",
    alt: "Schema zur Ermittlung der Rezirkulationszone nach VDI 3781 Blatt 4",
    caption: "Die erforderliche Mündungshöhe wurde anhand der Gebäudesituation und der Ableitbedingungen berechnet.",
    format: "landscape",
  },
  {
    src: "/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/vdi-3781-dachregel.webp",
    alt: "Schema zur Berechnung der Schornsteinhöhe über dem Dach nach VDI 3781 Blatt 4",
    caption: "Die Berechnung berücksichtigt unter anderem Dachgeometrie und Lage des Schornsteins.",
    format: "landscape",
  },
];
---

<BaseLayout
  title="Kaminverlängerung für Kaminofen in Pegnitz | Stadter Kamintechnik"
  description="Kaminverlängerung für einen bestehenden Kaminofen in Pegnitz. Schornsteinhöhe nach VDI 3781 Blatt 4 berechnet und mit einer doppelwandigen Edelstahlverlängerung hergestellt."
>
  <section class="reference-hero-portrait">
    <div class="container">
      <nav class="reference-hero-portrait__breadcrumb" aria-label="Brotkrümelnavigation">
        <a href="/">Startseite</a><span aria-hidden="true">/</span>
        <a href="/referenzen/">Referenzen</a><span aria-hidden="true">/</span>
        <span>Kaminverlängerung in Pegnitz</span>
      </nav>

      <div class="reference-hero-portrait__grid">
        <div class="reference-hero-portrait__content">
          <p class="reference-hero-portrait__category">Privat</p>
          <h1>Kaminverlängerung für einen bestehenden Kaminofen</h1>
          <p class="reference-hero-portrait__location">Pegnitz</p>
          <p class="reference-hero-portrait__intro">
            Die erforderliche Schornsteinhöhe wurde nach VDI 3781 Blatt 4 berechnet und mit einer doppelwandigen Edelstahl-Kaminverlängerung hergestellt. Dadurch konnte der bestehende Kaminofen weiter betrieben werden.
          </p>
        </div>

        <figure class="reference-hero-portrait__media">
          <img
            src="/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/kaminverlaengerung-pegnitz-hero.webp"
            alt="Doppelwandige Edelstahl-Kaminverlängerung auf einem bestehenden Schornstein in Pegnitz"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <ProjectFacts facts={facts} />
  <ProjectContent sections={contentSections} />

  <section class="project-gallery-custom" aria-labelledby="project-gallery-title">
    <div class="container">
      <div class="project-gallery-custom__header">
        <p class="project-gallery-custom__kicker">Berechnung und Umsetzung</p>
        <h2 id="project-gallery-title">Die passende Höhe für den sicheren Betrieb des Kaminofens.</h2>
      </div>

      <div class="project-gallery-custom__items">
        {galleryImages.map((image) => (
          <figure class:list={["project-gallery-custom__item", `project-gallery-custom__item--${image.format}`]}>
            <div class:list={["project-gallery-custom__media", `project-gallery-custom__media--${image.format}`]}>
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ProjectCTA
    title="Muss Ihr bestehender Schornstein verlängert werden?"
    text="Wir prüfen die Gebäudesituation, berechnen die erforderliche Schornsteinhöhe und montieren eine passende Kaminverlängerung."
    buttonText="Kaminverlängerung anfragen"
    buttonHref="/projekt-starten/?projekt=kaminverlaengerung"
  />
</BaseLayout>

<style>
  .reference-hero-portrait { padding: 2rem 0 6rem; }
  .reference-hero-portrait__breadcrumb { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 4rem; color: #777; font-size: 0.9rem; }
  .reference-hero-portrait__breadcrumb a { color: inherit; text-decoration: none; }
  .reference-hero-portrait__grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(3rem, 6vw, 7rem); align-items: center; }
  .reference-hero-portrait__content { max-width: 760px; }
  .reference-hero-portrait__category, .project-gallery-custom__kicker { margin: 0 0 1rem; color: #9d1f24; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
  .reference-hero-portrait h1 { margin: 0; font-size: clamp(2.7rem, 4.8vw, 5rem); line-height: 0.98; letter-spacing: -0.055em; }
  .reference-hero-portrait__location { margin: 1.65rem 0 0; color: #9d1f24; font-weight: 700; }
  .reference-hero-portrait__intro { max-width: 650px; margin: 1.5rem 0 0; color: #626262; font-size: 1.12rem; line-height: 1.7; }
  .reference-hero-portrait__media { width: 100%; margin: 0; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 12px; background: #f2f2f2; }
  .reference-hero-portrait__media img, .project-gallery-custom__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-gallery-custom { padding: 7rem 0; background: #f5f5f3; }
  .project-gallery-custom__header { max-width: 920px; margin-bottom: 3.5rem; }
  .project-gallery-custom h2 { margin: 0; font-size: clamp(2.35rem, 4vw, 4.4rem); line-height: 1.03; letter-spacing: -0.045em; }
  .project-gallery-custom__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4.5rem clamp(2rem, 5vw, 5rem); align-items: start; }
  .project-gallery-custom__item { width: min(100%, 520px); margin: 0; }
  .project-gallery-custom__media { overflow: hidden; border-radius: 10px; background: #e9e9e6; }
  .project-gallery-custom__media--portrait { aspect-ratio: 2 / 3; }
  .project-gallery-custom__media--landscape { aspect-ratio: 4 / 3; }
  .project-gallery-custom figcaption { margin-top: 1rem; color: #696969; font-size: 0.94rem; line-height: 1.55; }
  @media (max-width: 900px) {
    .reference-hero-portrait__grid { grid-template-columns: 1fr; }
    .reference-hero-portrait__media { width: min(100%, 440px); }
  }
  @media (max-width: 700px) {
    .reference-hero-portrait { padding-bottom: 4.5rem; }
    .reference-hero-portrait__breadcrumb { margin-bottom: 2.5rem; }
    .project-gallery-custom { padding: 5rem 0; }
    .project-gallery-custom__items { grid-template-columns: 1fr; gap: 3rem; }
    .project-gallery-custom__item { width: 100%; }
  }
</style>
