  {
    label: "Projektumfang",
    value: "Planung, Aufrichtung, Umschluss und Rückbau",
  },
];

const galleryImages = [
  {
    src: "/images/referenzen/kaminaufrichtung-kulmbach/kaminanlage-neu.jpg",
    alt: "Neue freistehende Kaminanlage für eine Dampfkesselanlage in Kulmbach",
    caption:
      "Die neue freistehende Kaminanlage wurde auf die Anforderungen der 10-MW-Dampfkesselanlage ausgelegt.",
  },
  {
    src: "/images/referenzen/kaminaufrichtung-kulmbach/kaminaufrichtung.jpg",
    alt: "Aufrichtung einer freistehenden Industriekaminanlage in Kulmbach",
    caption:
      "Die neue Kaminanlage wurde vor dem Umschluss des Kessels vollständig aufgerichtet.",
  },
  {
    src: "/images/referenzen/kaminaufrichtung-kulmbach/mauerwerkskamin-alt.jpg",
    alt: "Alter baufälliger Mauerwerkskamin vor dem Rückbau",
    caption:
      "Der baufällige Bestandskamin musste nach der Inbetriebnahme der neuen Anlage kontrolliert zurückgebaut werden.",
  },
  {
    src: "/images/referenzen/kaminaufrichtung-kulmbach/alt-und-neu.jpg",
