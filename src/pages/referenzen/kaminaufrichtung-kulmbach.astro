---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHero from "../../components/reference/ProjectHero.astro";
import ProjectContent from "../../components/reference/ProjectContent.astro";
import ProjectFacts from "../../components/reference/ProjectFacts.astro";
import ProjectGallery from "../../components/reference/ProjectGallery.astro";
import ProjectVideo from "../../components/reference/ProjectVideo.astro";
import ProjectCTA from "../../components/reference/ProjectCTA.astro";

const contentSections = [
  {
    kicker: "Die Aufgabe",
    title: "Einen baufälligen Mauerwerkskamin sicher ersetzen.",
    paragraphs: [
      "Für eine Dampfkesselanlage in Kulmbach musste ein alter, baufälliger Mauerwerkskamin zurückgebaut und durch eine neue Kaminanlage ersetzt werden.",
      "Neben der technischen Auslegung der neuen Anlage war besonders wichtig, den Rückbau und den späteren Umschluss so zu planen, dass der laufende Betrieb möglichst wenig beeinträchtigt wird.",
    ],
  },
  {
    kicker: "Das Konzept",
    title: "Eine freistehende Kaminanlage für 10 Megawatt Leistung.",
    paragraphs: [
      "Die neue Kaminanlage wurde auf eine Leistung von 10 Megawatt dimensioniert und passend zu den Anforderungen der vorhandenen Dampfkesselanlage ausgelegt.",
      "Parallel dazu wurde ein sicherer Ablauf für den Rückbau des alten Mauerwerkskamins entwickelt. Ziel war eine technisch klare Reihenfolge mit möglichst geringem Risiko für Produktion und umliegende Gebäude.",
    ],
  },
  {
    kicker: "Unsere Lösung",
    title: "Neue Kaminanlage aufrichten, Kessel umschließen, Altbestand rückbauen.",
    paragraphs: [
      "Stadter Kamintechnik realisierte eine komplett neue freistehende Kaminanlage aus einer Hand. Um einen Produktionsausfall zu vermeiden, wurde der Umschluss des Kessels gezielt während des Betriebsurlaubs durchgeführt.",
      "Nach der erfolgreichen Inbetriebnahme der neuen Anlage konnte der baufällige Mauerwerkskamin kontrolliert und ohne Schäden oder Beeinträchtigungen an den umliegenden Gebäuden zurückgebaut werden.",
    ],
    points: [
      "Neue freistehende Kaminanlage",
      "Dimensionierung für eine 10-MW-Dampfkesselanlage",
      "Geplanter Kesselumschluss im Betriebsurlaub",
      "Vermeidung eines Produktionsausfalls",
      "Sicherer Rückbau des alten Mauerwerkskamins",
      "Ausführung ohne Schäden an den umliegenden Gebäuden",
    ],
  },
  {
    kicker: "Das Ergebnis",
    title: "Kompakter, moderner und für die Zukunft ausgelegt.",
    paragraphs: [
      "Durch die passende Dimensionierung, hochwertige Materialien und moderne Verfahrenstechnik ist der Betrieb im Bereich der Abgasführung langfristig neu aufgestellt.",
