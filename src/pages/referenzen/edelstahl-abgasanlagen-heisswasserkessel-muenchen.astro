---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectContent from "../../components/reference/ProjectContent.astro";
import ProjectFacts from "../../components/reference/ProjectFacts.astro";
import ProjectCTA from "../../components/reference/ProjectCTA.astro";

const contentSections = [
  {
    kicker: "Die Aufgabe",
    title: "Zwei leistungsfähige Abgasanlagen für Heißwasserkessel mit jeweils 2,7 Megawatt.",
    paragraphs: [
      "Für eine neue Energiezentrale in München wurden zwei leistungsstarke Heißwasserkessel mit jeweils 2,7 MW installiert. Für jeden Wärmeerzeuger war eine eigene, zuverlässig dimensionierte Abgasführung erforderlich.",
      "Neben der hohen thermischen Leistung mussten insbesondere die sichere Abgasableitung über eine große Bauhöhe, die überdruckdichte Ausführung sowie die statischen Anforderungen der außenliegenden Schornsteinsysteme berücksichtigt werden.",
    ],
  },
  {
    kicker: "Das Konzept",
    title: "Zwei getrennte, überdruckdichte Edelstahlkamine für einen stabilen Anlagenbetrieb.",
    paragraphs: [
      "Für jeden Heißwasserkessel wurde ein eigenes doppelwandiges Edelstahl-Abgassystem vorgesehen. Beide Schornsteine wurden mit einer Höhe von 31 Metern und einem Durchmesser von 400 Millimetern ausgeführt.",
      "Die überdruckdichte Konstruktion ist auf den Betrieb moderner Kesselanlagen abgestimmt und ermöglicht eine sichere Ableitung der Abgase auch unter den hohen Leistungsanforderungen der Energiezentrale.",
    ],
  },
  {
    kicker: "Unsere Lösung",
    title: "Planung, Lieferung und Montage aus einer Hand.",
    paragraphs: [
      "Stadter Kamintechnik übernahm die Auslegung und Planung der beiden Schornsteinsysteme sowie deren Lieferung und vollständige Montage vor Ort.",
      "Die Arbeiten wurden in enger Abstimmung mit dem verantwortlichen Heizungsbauunternehmen und den weiteren Projektbeteiligten umgesetzt. Als Nachunternehmer konnten wir die beiden Abgasanlagen effizient in den Bauablauf der neuen Energiezentrale integrieren.",
      "Durch die präzise Abstimmung der technischen Schnittstellen und der Montageabläufe entstand eine dauerhaft belastbare und wartungsfreundliche Lösung.",
    ],
    points: [
      "Auslegung der Abgasanlagen für zwei Heißwasserkessel",
      "Planung der überdruckdichten Schornsteinsysteme",
      "Lieferung der doppelwandigen Edelstahlkamine",
      "Montage von zwei 31 Meter hohen Schornsteinen",
      "Ausführung mit jeweils 400 Millimetern Durchmesser",
      "Abstimmung mit Heizungsbauer und Projektbeteiligten",
      "Umsetzung als Nachunternehmer des Heizungsbauunternehmens",
    ],
  },
  {
    kicker: "Das Ergebnis",
    title: "Eine leistungsfähige und langlebige Abgaslösung für die neue Energiezentrale.",
    paragraphs: [
      "Mit den beiden neuen Edelstahlkaminen verfügt die Energiezentrale über zwei getrennte und sicher auf die Heißwasserkessel abgestimmte Abgaswege.",
      "Die überdruckdichte, doppelwandige Ausführung gewährleistet eine zuverlässige Ableitung der Abgase. Die 31 Meter hohen Schornsteine bilden gemeinsam mit den innenliegenden Anschlussleitungen eine dauerhaft betriebssichere Gesamtanlage.",
    ],
  },
];

const facts = [
  { label: "Objekt", value: "Energiezentrale" },
  { label: "Standort", value: "München" },
  { label: "Wärmeerzeuger", value: "2 Heißwasserkessel" },
  { label: "Kesselleistung", value: "Jeweils 2,7 MW" },
  { label: "Gesamtleistung", value: "5,4 MW" },
  { label: "Abgasanlage", value: "2 doppelwandige Edelstahlkamine" },
  { label: "Ausführung", value: "Überdruckdicht" },
  { label: "Höhe", value: "Jeweils 31 Meter" },
  { label: "Durchmesser", value: "Jeweils 400 Millimeter" },
  { label: "Leistungsumfang", value: "Planung, Lieferung und Montage" },
  { label: "Projektrolle", value: "Nachunternehmer des Heizungsbauunternehmens" },
];

const galleryImages = [
  {
    src: "/images/referenzen/heizzentrale-muenchen/edelstahlkamine-muenchen-aussen.webp",
    alt: "Zwei 31 Meter hohe Edelstahlkamine an einer Energiezentrale in München",
    caption: "Die beiden überdruckdichten Edelstahlkamine wurden außen am Gebäude bis auf eine Höhe von 31 Metern geführt.",
  },
  {
    src: "/images/referenzen/heizzentrale-muenchen/heisswasserkessel-abgasleitung.webp",
    alt: "Heißwasserkessel mit groß dimensionierter Edelstahl-Abgasleitung",
    caption: "Jeder Heißwasserkessel wurde über eine eigene Abgasstrecke an das zugehörige Schornsteinsystem angeschlossen.",
  },
  {
    src: "/images/referenzen/heizzentrale-muenchen/edelstahlkamine-muenchen-dach.webp",
    alt: "Mündungen zweier Edelstahlkamine über den Dächern von München",
    caption: "Die beiden getrennten Schornsteinmündungen gewährleisten eine sichere Ableitung der Abgase über die erforderliche Bauhöhe.",
  },
];
---

<BaseLayout
  title="Zwei Edelstahl-Abgasanlagen für eine Energiezentrale in München | Stadter Kamintechnik"
  description="Zwei überdruckdichte, doppelwandige Edelstahlkamine mit jeweils 31 Metern Höhe für Heißwasserkessel mit je 2,7 MW Leistung in München."
>
  <section class="reference-hero-portrait">
    <div class="container">
      <nav class="reference-hero-portrait__breadcrumb" aria-label="Brotkrümelnavigation">
        <a href="/">Startseite</a>
        <span aria-hidden="true">/</span>
        <a href="/referenzen/">Referenzen</a>
        <span aria-hidden="true">/</span>
        <span>Zwei Edelstahl-Abgasanlagen für eine Energiezentrale</span>
      </nav>

      <div class="reference-hero-portrait__grid">
        <div class="reference-hero-portrait__content">
          <p class="reference-hero-portrait__category">Industrie</p>
          <h1>Zwei Edelstahl-Abgasanlagen für eine Energiezentrale</h1>
          <p class="reference-hero-portrait__location">München</p>
          <p class="reference-hero-portrait__intro">
            Zwei überdruckdichte, doppelwandige Edelstahlkamine mit jeweils 31 Metern Höhe für zwei Heißwasserkessel mit je 2,7 MW Leistung.
          </p>
        </div>

        <figure class="reference-hero-portrait__media">
          <img
            src="/images/referenzen/heizzentrale-muenchen/edelstahlkamine-muenchen-aussen.webp"
            alt="Zwei 31 Meter hohe Edelstahlkamine an einer Energiezentrale in München"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <ProjectContent sections={contentSections} />
  <ProjectFacts facts={facts} />
  <section class="project-gallery-custom" aria-labelledby="project-gallery-title">
    <div class="container">
      <div class="project-gallery-custom__header">
        <p class="project-gallery-custom__kicker">Die Anlage im Detail</p>
        <h2 id="project-gallery-title">Zwei Abgaswege – vom Kessel bis zur Schornsteinmündung.</h2>
      </div>

      <div class="project-gallery-custom__items">
        <figure class="project-gallery-custom__item project-gallery-custom__item--portrait">
          <div class="project-gallery-custom__media project-gallery-custom__media--portrait">
            <img
              src={galleryImages[0].src}
              alt={galleryImages[0].alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{galleryImages[0].caption}</figcaption>
        </figure>

        <figure class="project-gallery-custom__item project-gallery-custom__item--landscape">
          <div class="project-gallery-custom__media project-gallery-custom__media--landscape">
            <img
              src={galleryImages[1].src}
              alt={galleryImages[1].alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{galleryImages[1].caption}</figcaption>
        </figure>

        <figure class="project-gallery-custom__item project-gallery-custom__item--portrait">
          <div class="project-gallery-custom__media project-gallery-custom__media--portrait">
            <img
              src={galleryImages[2].src}
              alt={galleryImages[2].alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{galleryImages[2].caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <ProjectCTA
    title="Sie planen eine Abgasanlage für eine Energie- oder Heizzentrale?"
    text="Wir planen, liefern und montieren leistungsfähige Edelstahl-Abgassysteme für Kesselanlagen, Energiezentralen und industrielle Wärmeerzeuger."
    buttonText="Projekt besprechen"
    buttonHref="/projekt-starten/?projekt=industrieabgasanlage"
  />
</BaseLayout>

<style>
  .reference-hero-portrait {
    padding: 2rem 0 6rem;
  }

  .reference-hero-portrait__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 4rem;
    color: #777;
    font-size: 0.9rem;
  }

  .reference-hero-portrait__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .reference-hero-portrait__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
  }

  .reference-hero-portrait__content {
    max-width: 640px;
  }

  .reference-hero-portrait__category {
    margin: 0 0 1rem;
    color: #9d1f24;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .reference-hero-portrait h1 {
    margin: 0;
    font-size: clamp(3rem, 5.2vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .reference-hero-portrait__location {
    margin: 1.65rem 0 0;
    color: #9d1f24;
    font-weight: 700;
  }

  .reference-hero-portrait__intro {
    max-width: 590px;
    margin: 1.5rem 0 0;
    color: #626262;
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .reference-hero-portrait__media {
    width: 100%;
    margin: 0;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: #f2f2f2;
  }

  .reference-hero-portrait__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  @media (max-width: 980px) {
    .reference-hero-portrait {
      padding-bottom: 4rem;
    }

    .reference-hero-portrait__breadcrumb {
      margin-bottom: 2.75rem;
    }

    .reference-hero-portrait__grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .reference-hero-portrait__media {
      width: min(100%, 420px);
    }
  }


  .project-gallery-custom {
    padding: 7rem 0;
    background: #f5f5f3;
  }

  .project-gallery-custom__header {
    max-width: 850px;
    margin-bottom: 3.5rem;
  }

  .project-gallery-custom__kicker {
    margin: 0 0 1rem;
    color: #9d1f24;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-gallery-custom h2 {
    margin: 0;
    font-size: clamp(2.35rem, 4vw, 4.4rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .project-gallery-custom__items {
    display: grid;
    gap: 4.5rem;
  }

  .project-gallery-custom__item {
    margin: 0;
  }

  .project-gallery-custom__item--portrait {
    width: min(100%, 430px);
  }

  .project-gallery-custom__item--landscape {
    width: 100%;
  }

  .project-gallery-custom__media {
    overflow: hidden;
    border-radius: 12px;
    background: #e9e9e7;
  }

  .project-gallery-custom__media--portrait {
    aspect-ratio: 2 / 3;
  }

  .project-gallery-custom__media--landscape {
    aspect-ratio: 16 / 9;
  }

  .project-gallery-custom__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-gallery-custom__media--portrait img {
    object-fit: contain;
    object-position: center;
  }

  .project-gallery-custom__media--landscape img {
    object-position: center;
  }

  .project-gallery-custom figcaption {
    margin-top: 1.1rem;
    max-width: 820px;
    color: #666;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .project-gallery-custom {
      padding: 5rem 0;
    }

    .project-gallery-custom__items {
      gap: 3rem;
    }

    .project-gallery-custom__item--portrait {
      width: min(100%, 420px);
    }
  }

</style>
