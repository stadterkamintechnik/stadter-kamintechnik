---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectContent from "../../components/reference/ProjectContent.astro";
import ProjectFacts from "../../components/reference/ProjectFacts.astro";
import ProjectCTA from "../../components/reference/ProjectCTA.astro";

const contentSections = [
  {
    kicker: "Die Ausgangssituation",
    title: "Ein älterer gemauerter Schornstein passte nicht mehr zur neuen Heizungsanlage.",
    paragraphs: [
      "Bei diesem Einfamilienhaus sollte der vorhandene Schornstein für eine neue Heizungsanlage weiter genutzt werden. Im bestehenden gemauerten Kamin waren die Schamotterohre beschädigt.",
      "Zusätzlich zeigten sich Ablagerungen und erste Anzeichen von Feuchtigkeit. Damit die neue Heizungsanlage sicher betrieben werden konnte, musste der Schornstein technisch angepasst werden.",
    ],
  },
  {
    kicker: "Die Planung",
    title: "Sanierung im Bestand statt eines vollständigen Kaminneubaus.",
    paragraphs: [
      "Nach der Prüfung des Schornsteins wurde entschieden, ein Edelstahl-Innenrohr in den bestehenden Schornsteinschacht einzuziehen.",
      "Das neue Innenrohr übernimmt die Abgasführung, stellt die erforderliche Dichtheit wieder her und passt den wirksamen Querschnitt an die neue Heizungsanlage an. Der vorhandene gemauerte Schornstein konnte dadurch erhalten bleiben.",
    ],
  },
  {
    kicker: "Die Ausführung",
    title: "Edelstahl-Innenrohr eingezogen und Anschlüsse fachgerecht hergestellt.",
    paragraphs: [
      "Für die Sanierung wurden die notwendigen Montageöffnungen hergestellt. Anschließend wurde das Edelstahlrohr von oben in den Schornsteinschacht eingesetzt und elementweise verbunden.",
      "Danach wurden die Anschlussstellen zur Heizungsanlage hergestellt und die Montageöffnungen wieder fachgerecht verschlossen. Der bestehende gemauerte Kaminschacht im Dachboden wurde nach Abschluss der Arbeiten neu verputzt.",
    ],
    points: [
      "Bestehender gemauerter Schornstein blieb erhalten",
      "Einzug eines Edelstahl-Innenrohres",
      "Anpassung des Schornsteinquerschnitts",
      "Herstellung der Anschlüsse zur neuen Heizungsanlage",
      "Fachgerechter Verschluss der Montageöffnungen",
      "Neu verputzter Kaminschacht im Dachboden",
      "Ausführung innerhalb eines Arbeitstages",
    ],
  },
  {
    kicker: "Das Ergebnis",
    title: "Der vorhandene Kamin kann wieder sicher genutzt werden.",
    paragraphs: [
      "Durch das Edelstahl-Innenrohr ist die Abgasführung wieder dicht und auf die neue Heizungsanlage abgestimmt. Die Abgase können sicher durch den bestehenden Schornstein abgeführt werden.",
      "Ein kompletter Neubau des Kamins war nicht erforderlich. Die Sanierung konnte innerhalb eines Arbeitstages umgesetzt werden.",
    ],
  },
];

const facts = [
  { label: "Projekt", value: "Kaminsanierung" },
  { label: "Gebäude", value: "Einfamilienhaus" },
  { label: "Bestand", value: "Gemauerter Schornstein mit beschädigten Schamotterohren" },
  { label: "Leistung", value: "Einbau eines Edelstahl-Innenrohres" },
  { label: "Schornsteinsystem", value: "Edelstahlrohr im bestehenden Kamin" },
  { label: "Anlass", value: "Anpassung an eine neue Heizungsanlage" },
  { label: "Montagedauer", value: "1 Arbeitstag" },
];

const galleryImages = [
  {
    src: "/images/referenzen/kaminsanierung-gemauerter-schornstein/alter-schornstein-innen.webp",
    alt: "Blick in den älteren gemauerten Schornstein mit beschädigten Schamotterohren und Ablagerungen",
    caption: "Der Blick in den Bestand zeigt beschädigte Schamotterohre und deutliche Ablagerungen im Schornstein.",
    format: "portrait",
  },
  {
    src: "/images/referenzen/kaminsanierung-gemauerter-schornstein/kaminschacht-dachboden.webp",
    alt: "Neu verputzter bestehender gemauerter Kaminschacht im Dachboden",
    caption: "Der bestehende gemauerte Kaminschacht im Dachboden blieb erhalten und wurde nach der Sanierung neu verputzt.",
    format: "portrait",
  },
  {
    src: "/images/referenzen/kaminsanierung-gemauerter-schornstein/anschluss-heizraum.webp",
    alt: "Edelstahlanschluss am sanierten Schornstein im Heizraum eines Einfamilienhauses",
    caption: "Der Anschluss zur Heizungsanlage wurde mit Edelstahlbauteilen sauber an den bestehenden Schornstein angebunden.",
    format: "portrait",
  },
  {
    src: "/images/referenzen/kaminsanierung-gemauerter-schornstein/anschluss-und-reinigung.webp",
    alt: "Anschlussöffnung und Reinigungsöffnung am sanierten gemauerten Schornstein",
    caption: "Anschluss- und Reinigungsöffnung sind zugänglich und fachgerecht in den sanierten Schornstein integriert.",
    format: "portrait",
  },
];
---

<BaseLayout
  title="Kaminsanierung eines gemauerten Schornsteins | Stadter Kamintechnik"
  description="Kaminsanierung im Einfamilienhaus: Edelstahl-Innenrohr in einen bestehenden gemauerten Schornstein eingezogen und an eine neue Heizungsanlage angepasst."
>
  <section class="reference-hero-portrait">
    <div class="container">
      <nav class="reference-hero-portrait__breadcrumb" aria-label="Brotkrümelnavigation">
        <a href="/">Startseite</a><span aria-hidden="true">/</span>
        <a href="/referenzen/">Referenzen</a><span aria-hidden="true">/</span>
        <span>Kaminsanierung im Einfamilienhaus</span>
      </nav>
      <div class="reference-hero-portrait__grid">
        <div class="reference-hero-portrait__content">
          <p class="reference-hero-portrait__category">Privat</p>
          <h1>Kaminsanierung eines gemauerten Schornsteins für eine neue Heizungsanlage</h1>
          <p class="reference-hero-portrait__location">Einfamilienhaus</p>
          <p class="reference-hero-portrait__intro">
            Ein Edelstahl-Innenrohr macht den bestehenden gemauerten Schornstein wieder dicht und passt die Abgasführung an die neue Heizungsanlage an – ohne vollständigen Kaminneubau.
          </p>
        </div>
        <figure class="reference-hero-portrait__media">
          <img src="/images/referenzen/kaminsanierung-gemauerter-schornstein/muendung-edelstahl.webp" alt="Fertige Edelstahlmündung auf dem sanierten gemauerten Schornstein eines Einfamilienhauses" loading="eager" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <ProjectFacts facts={facts} />
  <ProjectContent sections={contentSections} />

  <section class="project-gallery-custom" aria-labelledby="project-gallery-title">
    <div class="container">
      <div class="project-gallery-custom__header">
        <p class="project-gallery-custom__kicker">Vom Bestand zur fertigen Sanierung</p>
        <h2 id="project-gallery-title">Der vorhandene Schornstein bleibt erhalten – die Abgasführung wird erneuert.</h2>
      </div>
      <div class="project-gallery-custom__items">
        {galleryImages.map((image) => (
          <figure class:list={["project-gallery-custom__item", `project-gallery-custom__item--${image.format}`]}>
            <div class:list={["project-gallery-custom__media", `project-gallery-custom__media--${image.format}`]}>
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ProjectCTA
    title="Ihr bestehender Schornstein passt nicht mehr zur neuen Heizung?"
    text="Wir prüfen den vorhandenen Kamin und beraten Sie, ob eine Sanierung mit Edelstahl-Innenrohr die passende Lösung ist."
    buttonText="Kaminsanierung anfragen"
    buttonHref="/projekt-starten/?projekt=kaminsanierung"
  />
</BaseLayout>

<style>
  .reference-hero-portrait { padding: 2rem 0 6rem; }
  .reference-hero-portrait__breadcrumb { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 4rem; color: #777; font-size: 0.9rem; }
  .reference-hero-portrait__breadcrumb a { color: inherit; text-decoration: none; }
  .reference-hero-portrait__grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(3rem, 6vw, 7rem); align-items: center; }
  .reference-hero-portrait__content { max-width: 760px; }
  .reference-hero-portrait__category, .project-gallery-custom__kicker { margin: 0 0 1rem; color: #9d1f24; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
  .reference-hero-portrait h1 { margin: 0; font-size: clamp(2.7rem, 4.8vw, 5rem); line-height: 0.98; letter-spacing: -0.055em; }
  .reference-hero-portrait__location { margin: 1.65rem 0 0; color: #9d1f24; font-weight: 700; }
  .reference-hero-portrait__intro { max-width: 650px; margin: 1.5rem 0 0; color: #626262; font-size: 1.12rem; line-height: 1.7; }
  .reference-hero-portrait__media { width: 100%; margin: 0; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 12px; background: #f2f2f2; }
  .reference-hero-portrait__media img, .project-gallery-custom__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-gallery-custom { padding: 7rem 0; background: #f5f5f3; }
  .project-gallery-custom__header { max-width: 920px; margin-bottom: 3.5rem; }
  .project-gallery-custom h2 { margin: 0; font-size: clamp(2.35rem, 4vw, 4.4rem); line-height: 1.03; letter-spacing: -0.045em; }
  .project-gallery-custom__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4.5rem clamp(2rem, 5vw, 5rem); align-items: start; }
  .project-gallery-custom__item { width: min(100%, 430px); margin: 0; }
  .project-gallery-custom__item:nth-child(even) { justify-self: end; }
  .project-gallery-custom__media { overflow: hidden; border-radius: 12px; background: #e9e9e7; }
  .project-gallery-custom__media--portrait { aspect-ratio: 2 / 3; }
  .project-gallery-custom figcaption { margin-top: 1.1rem; color: #666; font-size: 0.98rem; line-height: 1.65; }
  @media (max-width: 980px) { .reference-hero-portrait { padding-bottom: 4rem; } .reference-hero-portrait__breadcrumb { margin-bottom: 2.75rem; } .reference-hero-portrait__grid { grid-template-columns: 1fr; gap: 2.75rem; } .reference-hero-portrait__media { width: min(100%, 420px); } .project-gallery-custom { padding: 5rem 0; } }
  @media (max-width: 720px) { .project-gallery-custom__items { grid-template-columns: 1fr; gap: 3rem; } .project-gallery-custom__item { width: 100%; justify-self: stretch !important; } }
</style>
