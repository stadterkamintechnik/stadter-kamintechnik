---
import "../styles/components/contact-section.css";
import ProjectForm from "./project/ProjectForm.astro";

const whatsappNumber = "49XXXXXXXXXX"; // <-- ersetzen
const whatsappText =
  "Guten Tag, ich möchte ein Projekt bei Stadter Kamintechnik anfragen.";

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`;
---

<section class="contact-section" id="projektanfrage">

    <div class="contact-section__inner">

        <!-- ===================================================== -->
        <!-- LINKS -->
        <!-- ===================================================== -->

        <aside class="contact-section__sidebar">

            <span class="section-label">
                Persönlich für Sie da
            </span>

            <h2>
                Wir freuen uns auf Ihr Projekt.
            </h2>

            <p class="contact-section__intro">

                Ob Einfamilienhaus, Gewerbe oder Industrie –
                wir beraten Sie persönlich und entwickeln gemeinsam
                die passende Lösung für Ihr Projekt.

            </p>

            <div class="contact-card-list">

                <a
                    class="contact-card"
                    href="tel:+49922899890000">

                    <span class="contact-card__label">
                        Telefon
                    </span>

                    <strong>
                        09228 998900-0
                    </strong>

                </a>

                <a
                    class="contact-card"
                    href="mailto:info@stadter-kamin.de">

                    <span class="contact-card__label">
                        E-Mail
                    </span>

                    <strong>
                        info@stadter-kamin.de
                    </strong>

                </a>

                <a
                    class="contact-card"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer">

                    <span class="contact-card__label">
                        WhatsApp
                    </span>

                    <strong>
                        Fotos & kurze Fragen
                    </strong>

                </a>

            </div>

            <div class="contact-hours">

                <span class="contact-hours__label">
                    Telefonisch erreichbar
                </span>

                <strong>

                    Montag bis Freitag

                    <br>

                    07:00 – 13:00 Uhr

                </strong>

            </div>

            <div class="contact-team">

                <span class="contact-team__label">
                    Persönliche Rückmeldung
                </span>

                <p>

                    Unser Projektteam prüft Ihre Anfrage
                    und meldet sich persönlich bei Ihnen.
                    Gemeinsam besprechen wir Ihr Projekt
                    und entwickeln die passende Lösung.

                </p>

            </div>

        </aside>

        <!-- ===================================================== -->
        <!-- RECHTS -->
        <!-- ===================================================== -->

        <div class="contact-section__form">

            <ProjectForm />

        </div>

    </div>

</section>