];
const factors=[
["Länge des Schornsteins","Mehr Länge bedeutet mehr Material und meist mehr Montageaufwand."],
["Querschnitt","Der erforderliche Durchmesser richtet sich nach Feuerstätte, Brennstoff, wirksamer Höhe und Betriebsweise."],
["Sanierungssystem","Werkstoff und Ausführung müssen zur Feuerungsanlage und den Abgasbedingungen passen."],
