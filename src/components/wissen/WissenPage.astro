  <script is:inline>
    const input = document.getElementById("wissen-search");
    const results = document.getElementById("wissen-search-results");
    const resultItems = [
      ...document.querySelectorAll(".w-search-result"),
    ];
    const empty = document.getElementById("wissen-search-empty");

    const normalize = (value) => {
      return value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/ß/g, "ss");
    };

    const updateSearch = () => {
      if (!input || !results) return;

      const term = normalize(input.value.trim());

      if (!term) {
        results.hidden = true;

        resultItems.forEach((item) => {
          item.hidden = true;
        });

        if (empty) {
          empty.hidden = true;
        }

        return;
      }

      let visible = 0;

      resultItems.forEach((item) => {
        const searchText = normalize(
          item.dataset.search || ""
        );

        const show = searchText.includes(term);

        item.hidden = !show;

        if (show) {
          visible++;
        }
      });

      results.hidden = false;

      if (empty) {
        empty.hidden = visible !== 0;
      }
    };

    input?.addEventListener("input", updateSearch);
    input?.addEventListener("search", updateSearch);
  </script>
