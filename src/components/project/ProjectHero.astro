---
import "../../styles/project-hero.css";

const whatsappNumber = "4915170661702";
const whatsappText =
  "Guten Tag, ich möchte ein Projekt bei Stadter Kamintechnik anfragen.";

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappText
)}`;
---

<section class="project-hero">
  <div class="project-hero__inner">
    <div class="project-hero__content">
      <p class="project-hero__eyebrow">Seit 2009 · Meisterbetrieb</p>

      <h1 class="project-hero__title">Projekt starten</h1>

      <h2 class="project-hero__headline">Erzählen Sie uns von Ihrem Projekt.</h2>

      <p class="project-hero__text">
        Jedes Gebäude ist anders. Deshalb beginnt bei uns jedes Projekt mit
        einem persönlichen Gespräch. So können wir Ihre Situation richtig
        einschätzen und die passende technische Lösung entwickeln.
      </p>

      <div class="project-hero__actions">
        <a class="button button--primary" href="#projektanfrage">
          Projektanfrage ausfüllen
        </a>

        <a
          class="button button--secondary"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12.04 2a9.82 9.82 0 0 0-8.5 14.75L2 22l5.38-1.41A9.95 9.95 0 1 0 12.04 2Zm0 17.93a8.02 8.02 0 0 1-4.09-1.12l-.29-.17-3.19.84.85-3.11-.19-.32a8.02 8.02 0 1 1 6.91 3.88Zm4.4-6.01c-.24-.12-1.43-.71-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19-.71-.64-1.2-1.43-1.34-1.67-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.09 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.15.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z"
            />
          </svg>

          Per WhatsApp schreiben
        </a>
      </div>

      <p class="project-hero__note">
        Für Privat-, Gewerbe- und Industriekunden in Nordbayern.
      </p>
    </div>

    <aside class="project-hero__trust" aria-label="Ihre Vorteile">
      <p class="project-hero__trust-label">Persönlich. Technisch. Passend.</p>

      <div class="project-hero__trust-item">
        <span class="project-hero__trust-number">01</span>
        <div>
          <h3>Persönliche Beratung</h3>
          <p>
            Ein erfahrener Ansprechpartner bespricht Ihr Projekt direkt mit
            Ihnen.
          </p>
        </div>
      </div>

      <div class="project-hero__trust-item">
        <span class="project-hero__trust-number">02</span>
        <div>
          <h3>Technische Einschätzung</h3>
          <p>
            Wir prüfen, welche Lösung für Ihr Gebäude sinnvoll und dauerhaft
            funktionsfähig ist.
          </p>
        </div>
      </div>

      <div class="project-hero__trust-item">
        <span class="project-hero__trust-number">03</span>
        <div>
          <h3>Individuelles Angebot</h3>
          <p>
            Erst nach der Beratung erstellen wir ein Angebot, das wirklich zu
            Ihrem Projekt passt.
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>
