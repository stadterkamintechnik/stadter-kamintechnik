---
import "../../styles/project/project-form.css";
---

<form
  class="project-form"
  id="project-form"
  method="post"
  enctype="multipart/form-data"
  novalidate
>
  <div class="project-form__header">
    <p class="project-form__eyebrow">
      In wenigen Minuten zur persönlichen Beratung
    </p>

    <h2 class="project-form__title">
      Projektanfrage
    </h2>

    <p class="project-form__intro">
      Beschreiben Sie uns kurz Ihr Vorhaben. Wir prüfen Ihre Anfrage und
      melden uns anschließend persönlich bei Ihnen.
    </p>
  </div>

  <div class="project-form__placeholder">

    <h3>🚧 Projektformular wird aufgebaut</h3>

    <p>
      Im nächsten Schritt ergänzen wir:
    </p>

    <ul>
      <li>Projektart</li>
      <li>Kontaktdaten</li>
      <li>PLZ & Ort</li>
      <li>Projektbeschreibung</li>
      <li>Dateiupload</li>
      <li>Datenschutz</li>
      <li>Versand</li>
    </ul>

    <button
      type="button"
      class="project-form__button"
    >
      Projekt jetzt starten
    </button>

  </div>

</form>