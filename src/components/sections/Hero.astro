---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/hero_privat.png';
---

<section class="hero">
  <Picture
    src={heroImage}
    formats={['avif', 'webp']}
    widths={[480, 768, 1024, 1280, 1672]}
    sizes="100vw"
    alt="Modernes Wohnhaus mit Edelstahl-Außenkamin"
    class="hero-image"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <span class="hero-kicker">
      Seit 2009 · Meisterbetrieb
    </span>

    <h1>Schornsteine, die funktionieren.</h1>

    <p>
      Seit 2009 planen und montieren wir Schornstein- und
      Abgassysteme für Wohnhäuser, Gewerbe und Industrie –
      zuverlässig, sauber und termintreu.
    </p>

    <div class="hero-buttons">
      <a href="/projekt-starten/" class="hero-primary">
        Projekt anfragen
      </a>

      <a href="/referenzen/" class="hero-secondary">
        Referenzen ansehen
      </a>
    </div>

    <div class="hero-facts">
      <span>✓ Seit 2009</span>
      <span>✓ Meisterbetrieb</span>
      <span>✓ Wohnhäuser · Gewerbe · Industrie</span>
    </div>
  </div>
</section>
