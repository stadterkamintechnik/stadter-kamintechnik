<section class="hero">
  <picture>
    <source
      type="image/avif"
      srcset="
        /images/hero/hero-480.avif 480w,
        /images/hero/hero-768.avif 768w,
        /images/hero/hero-1024.avif 1024w,
        /images/hero/hero-1280.avif 1280w,
        /images/hero/hero-1672.avif 1672w
      "
      sizes="100vw"
    />

    <source
      type="image/webp"
      srcset="
        /images/hero/hero-480.webp 480w,
        /images/hero/hero-768.webp 768w,
        /images/hero/hero-1024.webp 1024w,
        /images/hero/hero-1280.webp 1280w,
        /images/hero/hero-1672.webp 1672w
      "
      sizes="100vw"
    />

    <img
      src="/images/hero/hero-1672.webp"
      srcset="
        /images/hero/hero-480.webp 480w,
        /images/hero/hero-768.webp 768w,
        /images/hero/hero-1024.webp 1024w,
        /images/hero/hero-1280.webp 1280w,
        /images/hero/hero-1672.webp 1672w
      "
      sizes="100vw"
      alt="Modernes Wohnhaus mit Edelstahl-Außenkamin"
      class="hero-image"
      width="1672"
      height="941"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <span class="hero-kicker">
      Seit 2009 · Meisterbetrieb
    </span>

    <h1>Schornsteine, die funktionieren.</h1>

    <p>
      Seit 2009 planen und montieren wir Schornstein- und
      Abgassysteme für Wohnhäuser, Gewerbe und Industrie –
      zuverlässig, sauber und termintreu.
    </p>

    <div class="hero-buttons">
      <a href="/projekt-starten/" class="hero-primary">
        Projekt anfragen
      </a>

      <a href="/referenzen/" class="hero-secondary">
        Referenzen ansehen
      </a>
    </div>

    <div class="hero-facts">
      <span>✓ Seit 2009</span>
      <span>✓ Meisterbetrieb</span>
      <span>✓ Wohnhäuser · Gewerbe · Industrie</span>
    </div>
  </div>
</section>
