---
const projects = [
  {
    category: "Privat · Bayreuth",
    title: "Außenwandkamin am Fertighaus",
    description:
      "Nachrüstung eines doppelwandigen Edelstahl-Außenwandkamins für einen Kaminofen – mit Brandschutzdurchführung und nach VDI 3781 Blatt 4 ausgelegter Schornsteinhöhe.",
    location: "Bayreuth",
    building: "Fertighaus",
    solution: "Außenwandkamin",
    href: "/referenzen/aussenwandkamin-fertighaus-bayreuth",
    image: "/images/referenzen/aussenwandkamin-fertighaus-bayreuth/aussenwandkamin-fertighaus-gesamtansicht.webp",
    imageAlt: "Doppelwandiger Edelstahl-Außenwandkamin an einem Fertighaus in Bayreuth",
  },
  {
    category: "Privat · Nürnberg",
    title: "Versotteten Schornstein für eine Holzheizung saniert",
    description:
      "Edelstahlrohr eingebaut, Putz im Dachboden erneuert und die gefliesten Anschlussbereiche im Heizraum sauber wiederhergestellt.",
    location: "Nürnberg",
    building: "Wohngebäude",
    solution: "Kaminsanierung",
    href: "/referenzen/kaminsanierung-versotteter-schornstein-holzheizung-nuernberg",
    image: "/images/referenzen/kaminsanierung-versotteter-schornstein-nuernberg/kaminsanierung-nuernberg-aussen.webp",
    imageAlt: "Sanierter Schornsteinkopf auf einem Wohnhaus in Nürnberg",
  },
  {
    category: "Industrie",
    title: "20 MW. 32 Meter. Vier getrennte Abgaszüge.",
    description:
      "Freistehender Stahlschornstein mit vier Abgaszügen und rund 35 Metern geschweißter Abgasleitung für eine industrielle Dampfkesselanlage.",
    location: "Nordbayern",
    building: "Industrielle Heizzentrale",
    solution: "Stahlschornstein & Abgasstrecke",
    href: "/referenzen/freistehender-stahlschornstein-dampfkessel-heizzentrale",
    image: "/images/referenzen/stahlschornstein-dampfkessel/stahlschornstein-heizzentrale-hero.webp",
    imageAlt: "32 Meter hoher freistehender Stahlschornstein einer industriellen Heizzentrale",
  },
];
---

<section class="projects-section" aria-labelledby="projects-heading">
  <div class="projects-container">
    <header class="projects-header">
      <div>
        <p class="projects-kicker">Aus unserer Arbeit</p>
        <h2 id="projects-heading">Ausgewählte Projekte.</h2>
      </div>
      <p class="projects-intro">
        Von der privaten Nachrüstung bis zur komplexen Industrieanlage:
        echte Projekte, die zeigen, wie wir technische Aufgaben planen und umsetzen.
      </p>
    </header>

    <div class="projects-list">
      {projects.map((project, index) => (
        <article class:list={["project", index % 2 === 1 && "project--reversed"]}>
          <a class="project-media" href={project.href} aria-label={`${project.title} ansehen`}>
            <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
          </a>

          <div class="project-content">
            <p class="project-category">{project.category}</p>
            <h3><a href={project.href}>{project.title}</a></h3>
            <p class="project-description">{project.description}</p>
            <dl class="project-facts">
              <div><dt>Ort</dt><dd>{project.location}</dd></div>
              <div><dt>Objekt</dt><dd>{project.building}</dd></div>
              <div><dt>Lösung</dt><dd>{project.solution}</dd></div>
            </dl>
            <a class="project-link" href={project.href}>Mehr über dieses Projekt <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>

    <div class="projects-footer">
      <p>
        Weitere realisierte Projekte aus Kaminsanierung, Nachrüstung,
        Gewerbe und Industrie finden Sie in unserer Referenzübersicht.
      </p>
      <a class="projects-overview-link" href="/referenzen/">Alle Projekte ansehen <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .projects-section{padding:clamp(5rem,9vw,8.5rem) 1.25rem;background:#fff}
  .projects-container{width:min(100%,1240px);margin:0 auto}
  .projects-header{display:grid;grid-template-columns:minmax(0,.9fr) minmax(300px,.7fr);gap:clamp(2rem,7vw,7rem);align-items:end;margin-bottom:clamp(3.5rem,7vw,6.5rem)}
  .projects-kicker{margin:0 0 1rem;color:var(--color-primary,#971f25);font-size:.8rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .projects-header h2{max-width:700px;margin:0;color:var(--color-text,#1f1f1f);font-size:clamp(2.25rem,5vw,4.5rem);letter-spacing:-.05em;line-height:1}
  .projects-intro{max-width:560px;margin:0;color:#5f5f5f;font-size:clamp(1rem,1.4vw,1.125rem);line-height:1.75}
  .projects-list{display:grid;gap:clamp(5rem,10vw,9rem)}
  .project{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(340px,.75fr);gap:clamp(2.5rem,7vw,7rem);align-items:center}
  .project--reversed{grid-template-columns:minmax(340px,.75fr) minmax(0,1.25fr)}
  .project--reversed .project-media{grid-column:2}.project--reversed .project-content{grid-column:1;grid-row:1}
  .project-media{display:block;overflow:hidden;aspect-ratio:16/10;border-radius:10px;background:#e9e9e9}
  .project-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .project-media:hover img{transform:scale(1.025)}
  .project-category{margin:0 0 1rem;color:var(--color-primary,#971f25);font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .project-content h3{max-width:580px;margin:0;font-size:clamp(1.75rem,3.4vw,3rem);letter-spacing:-.04em;line-height:1.1}
  .project-content h3 a{color:var(--color-text,#1f1f1f);text-decoration:none}
  .project-description{max-width:570px;margin:1.5rem 0 0;color:#606060;line-height:1.75}
  .project-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:2rem 0 0}
  .project-facts div{padding-top:1rem;border-top:1px solid var(--color-border,#e6e6e6)}
  .project-facts dt{color:#8a8a8a;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .project-facts dd{margin:.45rem 0 0;font-size:.93rem;font-weight:600}
  .project-link,.projects-overview-link{display:inline-flex;width:fit-content;gap:.5rem;color:var(--color-primary,#971f25);font-size:.95rem;font-weight:700;text-decoration:none}
  .project-link{margin-top:2rem;padding-bottom:.25rem;border-bottom:1px solid rgba(151,31,37,.4)}
  .projects-footer{display:flex;gap:2rem;align-items:center;justify-content:space-between;margin-top:clamp(5rem,9vw,8rem);padding-top:2rem;border-top:1px solid var(--color-border,#e6e6e6)}
  .projects-footer p{max-width:720px;margin:0;color:#676767;line-height:1.65}
  @media(max-width:980px){.projects-header,.project,.project--reversed{grid-template-columns:1fr}.project--reversed .project-media,.project--reversed .project-content{grid-column:auto;grid-row:auto}.project-media{aspect-ratio:16/9}}
  @media(max-width:620px){.projects-section{padding-right:1rem;padding-left:1rem}.projects-list{gap:4.5rem}.project-media{aspect-ratio:4/3}.project-facts{grid-template-columns:1fr}.projects-footer{align-items:flex-start;flex-direction:column}}
</style>
