---
import "../../styles/layout/footer.css";

const currentYear = new Date().getFullYear();

const privateLinks = [
  { label: "Außenkamin nachrüsten", href: "/aussenkamin/" },
  {
    label: "Schornstein im Gebäude nachrüsten",
    href: "/schornstein-im-gebaeude-nachruesten/",
  },
  { label: "Kaminsanierung", href: "/kaminsanierung/" },
  { label: "Kaminverlängerung", href: "/kaminverlaengerung/" },
  { label: "Kaminkopf sanieren", href: "/kaminkopfsanieren/" },
];

const commercialLinks = [
  {
    label: "Stahlschornsteine",
    href: "/gewerbe-industrie/stahlschornsteine/",
  },
  {
    label: "Abgassysteme",
    href: "/gewerbe-industrie/abgassysteme/",
  },
  {
    label: "Sonderanlagen",
    href: "/gewerbe-industrie/sonderanlagen/",
  },
  {
    label: "Zustandsüberwachung",
    href: "/gewerbe-industrie/zustandsueberwachung/",
  },
];

const companyLinks = [
  { label: "Unternehmen", href: "/unternehmen/" },
  { label: "Referenzen", href: "/referenzen/" },
];

const socialLinks = [
  {
    label: "Instagram",
    href: "https://www.instagram.com/stadterkamintechnik/",
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/stadterkamintechnik",
  },
];
---

<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__statement">
      <div class="site-footer__statement-copy">
        <p class="site-footer__eyebrow">Stadter Kamintechnik</p>

        <h2 class="site-footer__headline">
          Schornsteine, die funktionieren.
        </h2>

        <div
          class="site-footer__mark site-footer__mark--mobile"
          aria-hidden="true"
        >
          <svg viewBox="0 0 200 200" focusable="false">
            <circle cx="100" cy="100" r="68"></circle>
          </svg>
        </div>

        <p class="site-footer__intro">
          Seit 2009 planen und montieren wir Schornstein- und Abgasanlagen für
          private, gewerbliche und industrielle Projekte in Nordbayern.
        </p>
      </div>

      <div
        class="site-footer__mark site-footer__mark--desktop"
        aria-hidden="true"
      >
        <svg viewBox="0 0 200 200" focusable="false">
          <circle cx="100" cy="100" r="68"></circle>
        </svg>
      </div>
    </div>

    <div class="site-footer__navigation">
      <nav
        class="site-footer__column"
        aria-labelledby="footer-private-heading"
      >
        <h2
          id="footer-private-heading"
          class="site-footer__column-title"
        >
          Privatkunden
        </h2>

        <ul class="site-footer__link-list">
          {
            privateLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="site-footer__column"
        aria-labelledby="footer-commercial-heading"
      >
        <h2
          id="footer-commercial-heading"
          class="site-footer__column-title"
        >
          Gewerbe &amp; Industrie
        </h2>

        <ul class="site-footer__link-list">
          {
            commercialLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="site-footer__column"
        aria-labelledby="footer-company-heading"
      >
        <h2
          id="footer-company-heading"
          class="site-footer__column-title"
        >
          Unternehmen
        </h2>

        <ul class="site-footer__link-list">
          {
            companyLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__column site-footer__contact">
        <h2 class="site-footer__column-title">Kontakt</h2>

        <a
          class="site-footer__phone"
          href="tel:+4992289989000"
          aria-label="Stadter Kamintechnik unter 09228 998900-0 anrufen"
        >
          09228 998900-0
        </a>

        <a
          class="site-footer__email"
          href="mailto:info@stadter-kamin.de"
        >
          info@stadter-kamin.de
        </a>

        <div class="site-footer__availability">
          <p class="site-footer__availability-title">
            Telefonisch erreichbar
          </p>

          <p>
            Montag – Freitag<br />
            07:00 – 13:00 Uhr
          </p>
        </div>

        <a
          class="site-footer__cta"
          href="/projekt-starten/"
        >
          <span>Projekt anfragen</span>
          <span aria-hidden="true">→</span>
        </a>

        <div class="site-footer__social">
          <p class="site-footer__social-title">
            Aktuelle Projekte &amp; Einblicke
          </p>

          <div class="site-footer__social-links">
            {
              socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__brand">
        <p class="site-footer__brand-name">
          Stadter Kamintechnik GmbH
        </p>

        <p class="site-footer__brand-claim">
          <strong>ÜBERRAGEND.</strong>
          <span>Schornsteine | Kamin- und Abgastechnik</span>
        </p>
      </div>

      <div class="site-footer__legal">
        <p>© {currentYear} Stadter Kamintechnik GmbH</p>

        <nav aria-label="Rechtliche Informationen">
          <ul>
            <li>
              <a href="/impressum/">Impressum</a>
            </li>
            <li>
              <a href="/datenschutz/">Datenschutz</a>
            </li>
            <li>
              <a href="/agb/">AGB</a>
            </li>
            <li>
              <a href="/widerruf/">Widerrufsbelehrung</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>