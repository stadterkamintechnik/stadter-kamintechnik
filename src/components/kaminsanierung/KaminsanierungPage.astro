const process = [
  ["01", "Erstgespräch", "Wir klären Schadensbild, Nutzung und geplante Feuerstätte oder Heizung."],
  ["02", "Besichtigung", "Wir prüfen den Schornstein vor Ort und bei Bedarf mit der Kaminkamera."],
  ["03", "Technische Planung", "Wir legen Verfahren, Material, Querschnitt und Anschlüsse fest."],
  ["04", "Abstimmung", "Die geplante Ausführung wird mit dem bevollmächtigten Bezirksschornsteinfeger abgestimmt."],
  ["05", "Angebot", "Sie erhalten eine nachvollziehbare Lösung mit klar beschriebenem Leistungsumfang."],
  ["06", "Sanierung", "Unsere eigenen Montageteams setzen die Arbeiten sauber und fachgerecht um."],
];

const faqs = [
  {
    q: "Wann ist eine Kaminsanierung notwendig?",
    a: "Typische Gründe sind Undichtigkeiten, Risse, beschädigte Innenrohre, Versottung, Feuchtigkeit oder die Anpassung an eine neue Feuerstätte beziehungsweise Heizungsanlage. Ob eine vollständige Sanierung nötig ist, entscheidet sich erst nach Prüfung des Bestands.",
  },
  {
    q: "Was kostet eine Kaminsanierung?",
    a: "Die Kosten hängen unter anderem vom Zustand des Schornsteins, der Höhe, dem benötigten Sanierungssystem und dem Aufwand vor Ort ab. Eine einfache Kaminsanierung mit einem neuen Innenrohr beginnt häufig bei etwa 2.000 €. Umfangreichere Sanierungen mit zusätzlichen Arbeiten am Schornstein oder Kaminkopf liegen oft im Bereich von 3.000 bis 5.000 € oder darüber. Nach einer Besichtigung erstellen wir Ihnen ein transparentes und nachvollziehbares Angebot.",
  },
  {
    q: "Wie wird ein Schornstein saniert?",
    a: "Häufig wird ein passendes Abgasrohr aus Edelstahl, Kunststoff oder einem keramischen Werkstoff in den vorhandenen Schacht eingebracht. Muss eine alte Innenabdichtung oder ein bestehendes Innenrohr entfernt werden, kann dies unter bestimmten Voraussetzungen durch Ausfräsen erfolgen. Der gemauerte Schacht beziehungsweise der Mantelstein selbst wird dabei nicht bearbeitet. Eine Innenabdichtung kommt heute nur noch in geeigneten Ausnahmefällen infrage.",
  },
  {
    q: "Welches Sanierungssystem ist das richtige?",
