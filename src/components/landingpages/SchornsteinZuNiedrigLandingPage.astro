---
import "../../styles/pages/lp-kaminbauer.css";

const situations = [
  ["Höhe wurde bemängelt", "Der Schornsteinfeger fordert eine größere Mündungshöhe oder eine technische Klärung?", "/projekt-starten/?projekt=kaminverlaengerung"],
  ["Kamin zieht schlecht", "Der Abbrand ist instabil oder Rauch gelangt beim Anheizen und Nachlegen in den Raum?", "/projekt-starten/?projekt=kaminverlaengerung"],
  ["Neue Feuerstätte", "Für einen neuen Kaminofen oder eine neue Heizung muss die erforderliche Höhe geprüft werden?", "/projekt-starten/?projekt=kaminverlaengerung"],
  ["Gebäude im Umfeld", "Dachform, Anbauten oder benachbarte Gebäude beeinflussen die freie Abströmung?", "/projekt-starten/?projekt=kaminverlaengerung"],
];

const steps = [
  ["1", "Situation zeigen", "Senden Sie Fotos von Gebäude, Dach, Schornstein und Umgebung sowie vorhandene Unterlagen zur Feuerstätte."],
  ["2", "Höhe berechnen", "Wir prüfen die Ableitbedingungen und ermitteln die erforderliche Schornsteinhöhe für das konkrete Gebäude."],
  ["3", "Ausführung planen", "Länge, Durchmesser, Befestigung und statische Anforderungen werden passend zum Bestand festgelegt."],
  ["4", "Fachgerecht verlängern", "Unser eigenes Montageteam setzt die geplante Kaminverlängerung sicher und sauber um."],
];
---

<article class="kb">
  <section class="kb-hero">
    <div class="container">
      <p class="kb-kicker">Schornstein zu niedrig · Nordbayern · Meisterbetrieb</p>
      <h1>Ist Ihr Schornstein zu niedrig?<span>Wir berechnen die erforderliche Höhe.</span></h1>
      <p class="kb-lead">Eine Kaminverlängerung darf nicht nach Gefühl dimensioniert werden. Gebäude, Dachform, Feuerstätte und Umgebung entscheiden darüber, welche Höhe technisch erforderlich ist.</p>

      <div class="kb-actions">
        <a class="kb-primary" href="/projekt-starten/?projekt=kaminverlaengerung">Schornsteinhöhe prüfen lassen <span>→</span></a>
        <a class="kb-phone" href="tel:+4992289989000">09228 998900-0</a>
      </div>

      <figure class="kb-hero-image">
        <img src="/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/kaminverlaengerung-pegnitz-hero.webp" alt="Doppelwandige Edelstahl-Kaminverlängerung auf einem bestehenden Schornstein in Pegnitz" width="900" height="1350" decoding="async" fetchpriority="high" />
        <figcaption>Reales Projekt · berechnete Kaminverlängerung in Pegnitz</figcaption>
      </figure>

      <div class="kb-trust">
        <div><strong>10.000+</strong><span>Projekte</span></div>
        <div><strong>Meisterbetrieb</strong><span>Fachplanung</span></div>
        <div><strong>Eigene Teams</strong><span>Montage</span></div>
      </div>
    </div>
  </section>

  <section class="kb-solutions">
    <div class="container">
      <p class="kb-kicker">Warum muss die Höhe geprüft werden?</p>
      <h2>Nicht jede Zugstörung wird durch dieselbe Verlängerung gelöst.</h2>
      <div class="kb-solution-grid">
        {situations.map(([title,text,href]) => (
          <a class="kb-solution" href={href}>
            <div><h3>{title}</h3><p>{text}</p></div><span>→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="kb-proof">
    <div class="container">
      <figure>
        <img src="/images/referenzen/kaminverlaengerung-kaminofen-pegnitz/vdi-3781-dachregel.webp" alt="Schema zur Berechnung der Schornsteinhöhe über dem Dach nach VDI 3781 Blatt 4" width="1200" height="900" loading="lazy" decoding="async" />
      </figure>
      <div class="kb-proof-copy">
        <p class="kb-kicker">Berechnen statt schätzen.</p>
        <h2>Die richtige Höhe entsteht aus dem Gebäude.</h2>
        <p>Dachgeometrie, Lage der Schornsteinmündung, Feuerstätte und Bebauung im Umfeld beeinflussen die erforderliche Höhe. Wir betrachten diese Faktoren gemeinsam und planen daraus eine technisch passende und sicher befestigte Verlängerung.</p>
        <a href="/referenzen/kaminverlaengerung-kaminofen-pegnitz">Projekt in Pegnitz ansehen <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="kb-process">
    <div class="container">
      <p class="kb-kicker">Von der Prüfung zur Kaminverlängerung</p>
      <h2>So gehen wir vor.</h2>
      <ol>
        {steps.map(([n,title,text]) => (
          <li><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="kb-final">
    <div class="container">
      <p class="kb-kicker">Bayreuth · Kulmbach · Bamberg · Coburg · Nordbayern</p>
      <h2>Zeigen Sie uns Gebäude und Schornstein.</h2>
      <p>Fotos von Dach, Fassade, Schornstein und Umgebung helfen bei der ersten Einordnung. Wir prüfen, ob eine Verlängerung sinnvoll ist und welche Höhe benötigt wird.</p>
      <a class="kb-primary kb-primary--light" href="/projekt-starten/?projekt=kaminverlaengerung">Fotos &amp; Angaben senden <span>→</span></a>
      <a class="kb-final-phone" href="tel:+4992289989000">Oder anrufen: 09228 998900-0</a>
    </div>
  </section>

  <nav class="kb-sticky" aria-label="Schnellkontakt">
    <a href="tel:+4992289989000">Anrufen</a>
    <a href="/projekt-starten/?projekt=kaminverlaengerung">Höhe prüfen lassen <span>→</span></a>
  </nav>
</article>
