---
import "../../styles/pages/lp-kaminbauer.css";

const situations = [
  ["Versottung & Feuchtigkeit", "Braune Flecken, Geruch oder Feuchtigkeit am Schornstein?", "/projekt-starten/?projekt=kaminsanierung"],
  ["Neue Heizung", "Der vorhandene Schornstein passt nicht zur neuen Feuerstätte oder Heiztechnik?", "/projekt-starten/?projekt=kaminsanierung"],
  ["Risse & Schäden", "Innenrohr, Schacht oder Kaminkopf zeigen erkennbare Schäden?", "/projekt-starten/?projekt=kaminsanierung"],
  ["Querschnitt anpassen", "Der vorhandene Schornstein ist für den sicheren Betrieb ungeeignet dimensioniert?", "/projekt-starten/?projekt=kaminsanierung"],
];

const steps = [
  ["1", "Situation zeigen", "Projekt kurz beschreiben und vorhandene Fotos mitsenden."],
  ["2", "Ursache klären", "Wir prüfen, warum der bestehende Schornstein nicht mehr zur Nutzung passt."],
  ["3", "Lösung planen", "Material, Querschnitt und Ausführung werden passend zur Feuerstätte festgelegt."],
  ["4", "Sanieren", "Unsere eigenen Teams setzen die geplante Kaminsanierung fachgerecht um."],
];
---

<article class="kb">
  <section class="kb-hero">
    <div class="container">
      <p class="kb-kicker">Kaminsanierung in Nordbayern · Meisterbetrieb</p>
      <h1>Schornstein sanieren?<span>Erst die Ursache klären.</span></h1>
      <p class="kb-lead">Feuchtigkeit, Versottung, Schäden oder eine neue Heizung: Wir prüfen, was Ihr Schornstein wirklich braucht – und planen danach die passende Sanierung.</p>

      <div class="kb-actions">
        <a class="kb-primary" href="/projekt-starten/?projekt=kaminsanierung">Sanierung prüfen lassen <span>→</span></a>
        <a class="kb-phone" href="tel:+4992289989000">09228 998900-0</a>
      </div>

      <figure class="kb-hero-image">
        <img src="/images/referenzen/kaminsanierung-gemauerter-schornstein/alter-schornstein-innen.webp" alt="Bestehender Schornstein vor einer Kaminsanierung" width="1200" height="900" decoding="async" fetchpriority="high" />
        <figcaption>Reales Projekt · Bestand vor der Sanierung</figcaption>
      </figure>

      <div class="kb-trust">
        <div><strong>10.000+</strong><span>Projekte</span></div>
        <div><strong>Meisterbetrieb</strong><span>Fachplanung</span></div>
        <div><strong>Eigene Teams</strong><span>Montage</span></div>
      </div>
    </div>
  </section>

  <section class="kb-solutions">
    <div class="container">
      <p class="kb-kicker">Wann ist eine Kaminsanierung sinnvoll?</p>
      <h2>Das Problem entscheidet über die Lösung.</h2>
      <div class="kb-solution-grid">
        {situations.map(([title,text,href]) => (
          <a class="kb-solution" href={href}>
            <div><h3>{title}</h3><p>{text}</p></div><span>→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="kb-proof">
    <div class="container">
      <figure>
        <img src="/images/referenzen/kaminsanierung-gemauerter-schornstein/alter-schornstein-innen.webp" alt="Blick in einen bestehenden Schornstein vor der Sanierung" width="900" height="675" loading="lazy" decoding="async" />
      </figure>
      <div class="kb-proof-copy">
        <p class="kb-kicker">Probleme lösen statt Produkte verkaufen.</p>
        <h2>Nicht einfach ein Rohr einbauen.</h2>
        <p>Eine gute Kaminsanierung beginnt mit der Frage, warum der Bestand nicht mehr funktioniert. Feuerstätte, Abgastemperatur, Querschnitt, Feuchtigkeit und vorhandener Schacht müssen zusammenpassen.</p>
        <a href="/wissen/kaminsanierung-kosten/">Kosten &amp; Sanierung verstehen <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="kb-process">
    <div class="container">
      <p class="kb-kicker">Vom Bestand zur passenden Lösung</p>
      <h2>So starten Sie die Sanierung.</h2>
      <ol>
        {steps.map(([n,title,text]) => (
          <li><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="kb-final">
    <div class="container">
      <p class="kb-kicker">Bayreuth · Kulmbach · Bamberg · Coburg · Nordbayern</p>
      <h2>Zeigen Sie uns Ihren Schornstein.</h2>
      <p>Fotos, Angaben zur Heizung oder Feuerstätte und eine kurze Beschreibung reichen für den Einstieg. Wir prüfen, wie es weitergeht.</p>
      <a class="kb-primary kb-primary--light" href="/projekt-starten/?projekt=kaminsanierung">Sanierung &amp; Fotos senden <span>→</span></a>
      <a class="kb-final-phone" href="tel:+4992289989000">Oder anrufen: 09228 998900-0</a>
    </div>
  </section>

  <nav class="kb-sticky" aria-label="Schnellkontakt">
    <a href="tel:+4992289989000">Anrufen</a>
    <a href="/projekt-starten/?projekt=kaminsanierung">Sanierung anfragen <span>→</span></a>
  </nav>
</article>
