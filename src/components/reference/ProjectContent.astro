---
import "../../styles/project-content.css";

interface ContentSection {
  kicker?: string;
  title: string;
  paragraphs: string[];
  points?: string[];
}

interface Props {
  sections: ContentSection[];
}

const { sections } = Astro.props;
---

<section class="stk-reference-story">
  <div class="stk-reference-story__container">
    {
      sections.map((section) => (
        <article class="stk-reference-story__block">
          <header class="stk-reference-story__heading">
            {section.kicker && (
              <p class="stk-reference-story__kicker">
                {section.kicker}
              </p>
            )}

            <h2 class="stk-reference-story__title">
              {section.title}
            </h2>
          </header>

          <div class="stk-reference-story__content">
            {
              section.paragraphs.map((paragraph) => (
                <p class="stk-reference-story__paragraph">
                  {paragraph}
                </p>
              ))
            }

            {
              section.points && section.points.length > 0 && (
                <ul class="stk-reference-story__list">
                  {
                    section.points.map((point) => (
                      <li class="stk-reference-story__list-item">
                        <span class="stk-reference-story__list-text">
                          {point}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>