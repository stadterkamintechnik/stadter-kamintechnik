---
interface ReferenceProject {
  title: string;
  category: "Privat" | "Gewerbe" | "Industrie";
  location: string;
  description: string;
  image: string;
  imageAlt: string;
  href: string;
  tags?: string[];
}

interface Props {
  projects: ReferenceProject[];
}

const { projects } = Astro.props as Props;
---

<section
  class="stk-reference-overview"
  aria-labelledby="reference-overview-title"
>
  <div class="stk-reference-overview__container">
    <header class="stk-reference-overview__header">
      <div class="stk-reference-overview__heading">
        <p class="stk-reference-overview__kicker">
          Ausgewählte Projekte
        </p>

        <h1 id="reference-overview-title">
          Lösungen, die in der Praxis funktionieren.
        </h1>
      </div>

      <div class="stk-reference-overview__intro">
        <p>
          Von privaten Edelstahl-Außenkaminen über gewerbliche
          Heizzentralen bis zu anspruchsvollen Industrieanlagen:
          Hier zeigen wir ausgewählte Projekte aus Planung,
          Montage und technischer Umsetzung.
        </p>
      </div>
    </header>

    <div class="stk-reference-overview__grid">
      {
        projects.map((project, index) => (
          <article class="stk-reference-card">
            <a
              class="stk-reference-card__link"
              href={project.href}
              aria-label={`${project.title} ansehen`}
            >
              <figure class="stk-reference-card__media">
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  width="1600"
                  height="1100"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                />

                <div class="stk-reference-card__overlay">
                  <span>Projekt ansehen</span>

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m14 7 5 5-5 5" />
                  </svg>
                </div>
              </figure>

              <div class="stk-reference-card__content">
                <div class="stk-reference-card__meta">
                  <span>{project.category}</span>
                  <span aria-hidden="true">·</span>
                  <span>{project.location}</span>
                </div>

                <h2>{project.title}</h2>

                <p>{project.description}</p>

                {
                  project.tags &&
                  project.tags.length > 0 && (
                    <ul
                      class="stk-reference-card__tags"
                      aria-label="Projektmerkmale"
                    >
                      {
                        project.tags.map((tag) => (
                          <li>{tag}</li>
                        ))
                      }
                    </ul>
                  )
                }
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stk-reference-overview {
    padding: clamp(4.5rem, 8vw, 8rem) 0;
    background: #f7f5f2;
  }

  .stk-reference-overview__container {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .stk-reference-overview__header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .stk-reference-overview__kicker {
    margin: 0 0 0.9rem;
    color: #8f1d22;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .stk-reference-overview__heading h1 {
    max-width: 780px;
    margin: 0;
    color: #191919;
    font-size: clamp(2.35rem, 5vw, 4.7rem);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .stk-reference-overview__intro p {
    margin: 0;
    color: #5d5a57;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.7;
  }

  .stk-reference-overview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .stk-reference-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(25, 25, 25, 0.08);
    border-radius: 1rem;
    background: #ffffff;
    box-shadow: 0 12px 34px rgba(25, 25, 25, 0.06);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .stk-reference-card:hover {
    transform: translateY(-4px);
    border-color: rgba(143, 29, 34, 0.2);
    box-shadow: 0 18px 45px rgba(25, 25, 25, 0.1);
  }

  .stk-reference-card__link {
    display: flex;
    height: 100%;
    color: inherit;
    text-decoration: none;
    flex-direction: column;
  }

  .stk-reference-card__media {
    position: relative;
    aspect-ratio: 16 / 11;
    margin: 0;
    overflow: hidden;
    background: #e9e5e0;
  }

  .stk-reference-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .stk-reference-card:hover .stk-reference-card__media img {
    transform: scale(1.035);
  }

  .stk-reference-card__overlay {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.6rem 1.15rem 1rem;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 750;
    opacity: 0;
    background: linear-gradient(
      to top,
      rgba(18, 18, 18, 0.74),
      rgba(18, 18, 18, 0)
    );
    transition: opacity 220ms ease;
  }

  .stk-reference-card:hover .stk-reference-card__overlay,
  .stk-reference-card__link:focus-visible .stk-reference-card__overlay {
    opacity: 1;
  }

  .stk-reference-card__overlay svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .stk-reference-card__content {
    display: flex;
    flex: 1;
    padding: 1.4rem;
    flex-direction: column;
  }

  .stk-reference-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #8f1d22;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .stk-reference-card__content h2 {
    margin: 0;
    color: #1c1c1c;
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    font-weight: 740;
    letter-spacing: -0.025em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .stk-reference-card__content > p {
    margin: 0.9rem 0 0;
    color: #625f5b;
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .stk-reference-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: auto 0 0;
    padding: 1.25rem 0 0;
    list-style: none;
  }

  .stk-reference-card__tags li {
    padding: 0.42rem 0.65rem;
    border-radius: 999px;
    background: #f3efeb;
    color: #47433f;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .stk-reference-card__link:focus-visible {
    outline: 3px solid rgba(143, 29, 34, 0.35);
    outline-offset: -3px;
  }

  @media (max-width: 980px) {
    .stk-reference-overview__header {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: start;
    }

    .stk-reference-overview__intro {
      max-width: 700px;
    }

    .stk-reference-overview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .stk-reference-overview {
      padding: 3.5rem 0 4.5rem;
    }

    .stk-reference-overview__container {
      width: min(100% - 1.25rem, 1180px);
    }

    .stk-reference-overview__header {
      margin-bottom: 2rem;
    }

    .stk-reference-overview__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .stk-reference-card__content {
      padding: 1.2rem;
    }

    .stk-reference-card__overlay {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stk-reference-card,
    .stk-reference-card__media img,
    .stk-reference-card__overlay {
      transition: none;
    }

    .stk-reference-card:hover {
      transform: none;
    }

    .stk-reference-card:hover .stk-reference-card__media img {
      transform: none;
    }
  }
</style>
