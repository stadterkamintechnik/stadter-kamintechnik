---
interface Props {
  title?: string;
  text?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = "Sie planen ein ähnliches Projekt?",
  text = "Wir beraten Sie persönlich, prüfen die technischen Anforderungen und entwickeln eine Lösung, die dauerhaft funktioniert.",
  buttonText = "Projekt anfragen",
  buttonHref = "/kontakt",
} = Astro.props;
---

<section class="project-cta-section">
  <div class="project-cta-container">
    <div class="project-cta-content">
      <p class="project-cta-kicker">Ihr Projekt</p>

      <h2>{title}</h2>

      <p class="project-cta-text">
        {text}
      </p>
    </div>

    <a class="project-cta-button" href={buttonHref}>
      {buttonText}

      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4 10h11" />
        <path d="m11 6 4 4-4 4" />
      </svg>
    </a>
  </div>
</section>

<style>
  .project-cta-section {
    padding: clamp(5rem, 9vw, 8rem) 1.25rem;
    background: #1f1f1f;
    color: #ffffff;
  }

  .project-cta-container {
    display: flex;
    width: min(100%, 1120px);
    gap: 3rem;
    align-items: flex-end;
    justify-content: space-between;
    margin: 0 auto;
  }

  .project-cta-content {
    max-width: 760px;
  }

  .project-cta-kicker {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-cta-content h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .project-cta-text {
    max-width: 680px;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
  }

  .project-cta-button {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.65rem;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0.95rem 1.4rem;
    border-radius: 6px;
    background: var(--color-primary, #971f25);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .project-cta-button:hover {
    background: var(--color-primary-hover, #7c181d);
    transform: translateY(-2px);
  }

  .project-cta-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 800px) {
    .project-cta-container {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .project-cta-section {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .project-cta-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-cta-button {
      transition: none;
    }

    .project-cta-button:hover {
      transform: none;
    }
  }
</style>