---
interface Props {
  id?: string;
  title: string;
  text: string;
  youtubeId: string;
  facts?: string[];
}

const {
  id = "projektfilm",
  title,
  text,
  youtubeId,
  facts = [],
} = Astro.props;

const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`;
const titleId = `${id}-title`;
---

<section class="project-video" id={id} aria-labelledby={titleId}>
  <div class="container project-video__inner">
    <header class="project-video__header">
      <p class="project-video__kicker">Unsere Projekte in Bewegung</p>
      <h2 id={titleId}>{title}</h2>
      <p>{text}</p>
    </header>

    <div class="project-video__frame">
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    {facts.length > 0 && (
      <ul class="project-video__facts" aria-label="Projekthighlights">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .project-video {
    scroll-margin-top: 6rem;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background: #202020;
    color: #ffffff;
  }

  .project-video__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .project-video__header {
    max-width: 62rem;
  }

  .project-video__kicker {
    margin: 0 0 0.9rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-video__header h2 {
    max-width: 58rem;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .project-video__header > p:last-child {
    max-width: 52rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.08rem;
    line-height: 1.72;
  }

  .project-video__frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #111111;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.28);
  }

  .project-video__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .project-video__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.15);
    list-style: none;
  }

  .project-video__facts li {
    min-height: 7rem;
    display: flex;
    align-items: center;
    padding: 1.5rem;
    background: #202020;
    font-weight: 750;
    line-height: 1.4;
  }

  .project-video__facts li::before {
    content: "✓";
    margin-right: 0.8rem;
    color: var(--color-primary, #971f25);
    font-weight: 900;
  }

  @media (max-width: 700px) {
    .project-video__facts {
      grid-template-columns: 1fr;
    }

    .project-video__facts li {
      min-height: 0;
    }
  }
</style>
