---
interface Props {
  id?: string;
  title: string;
  text: string;
  youtubeId: string;
  facts?: string[];
}

const {
  id = "projektfilm",
  title,
  text,
  youtubeId,
  facts = [],
} = Astro.props;

const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`;
const titleId = `${id}-title`;
---

<section
  class="project-video"
  id={id}
  aria-labelledby={titleId}
  data-project-video
  data-youtube-url={embedUrl}
>
  <div class="container project-video__inner">
    <header class="project-video__header">
      <p class="project-video__kicker">Unsere Projekte in Bewegung</p>
      <h2 id={titleId}>{title}</h2>
      <p>{text}</p>
    </header>

    <div class="project-video__frame" data-video-frame>
      <div class="project-video__consent" data-video-consent>
        <div class="project-video__consent-inner">
          <p class="project-video__consent-title">Video von YouTube</p>
          <p class="project-video__consent-text">
            Für die Wiedergabe dieses Videos wird eine Verbindung zu YouTube hergestellt.
            Dafür benötigen wir Ihre Einwilligung für Marketing-Inhalte.
          </p>

          <button
            class="project-video__consent-button"
            type="button"
            data-video-consent-button
          >
            Video laden
          </button>

          <p class="project-video__consent-note">
            Ihre Auswahl können Sie jederzeit über die Cookie-Einstellungen ändern.
          </p>
        </div>
      </div>
    </div>

    {facts.length > 0 && (
      <ul class="project-video__facts" aria-label="Projekthighlights">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    )}
  </div>
</section>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll("[data-project-video]");

    function hasMarketingConsent() {
      return Boolean(
        window.Cookiebot &&
        window.Cookiebot.consent &&
        window.Cookiebot.consent.marketing
      );
    }

    function loadVideo(section) {
      if (section.dataset.videoLoaded === "true") return;

      const frame = section.querySelector("[data-video-frame]");
      const consent = section.querySelector("[data-video-consent]");
      const youtubeUrl = section.dataset.youtubeUrl;

      if (!frame || !youtubeUrl) return;

      const iframe = document.createElement("iframe");
      iframe.src = youtubeUrl;
      iframe.title =
        section.querySelector("h2")?.textContent?.trim() || "YouTube-Video";
      iframe.loading = "lazy";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.allowFullscreen = true;

      if (consent) consent.remove();
      frame.appendChild(iframe);

      section.dataset.videoLoaded = "true";
    }

    function updateVideos() {
      if (!hasMarketingConsent()) return;

      sections.forEach((section) => {
        loadVideo(section);
      });
    }

    sections.forEach((section) => {
      const button = section.querySelector("[data-video-consent-button]");

      button?.addEventListener("click", () => {
        if (hasMarketingConsent()) {
          loadVideo(section);
          return;
        }

        if (window.Cookiebot?.renew) {
          window.Cookiebot.renew();
        }
      });
    });

    if (window.Cookiebot) {
      updateVideos();
    }

    window.addEventListener("CookiebotOnConsentReady", updateVideos, false);
    window.addEventListener("CookiebotOnAccept", updateVideos, false);
  })();
</script>

<style>
  .project-video {
    scroll-margin-top: 6rem;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background: #202020;
    color: #ffffff;
  }

  .project-video__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .project-video__header {
    max-width: 62rem;
  }

  .project-video__kicker {
    margin: 0 0 0.9rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-video__header h2 {
    max-width: 58rem;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .project-video__header > p:last-child {
    max-width: 52rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.08rem;
    line-height: 1.72;
  }

  .project-video__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #111111;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.28);
  }

  .project-video__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .project-video__consent {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04),
        rgba(255, 255, 255, 0)
      ),
      #111111;
  }

  .project-video__consent-inner {
    width: min(100%, 42rem);
    text-align: center;
  }

  .project-video__consent-title {
    margin: 0 0 0.75rem;
    color: #ffffff;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .project-video__consent-text {
    margin: 0 auto;
    max-width: 38rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }

  .project-video__consent-button {
    min-height: 3.5rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.4rem;
    border: 1px solid var(--color-primary, #971f25);
    border-radius: 6px;
    color: #ffffff;
    background: var(--color-primary, #971f25);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .project-video__consent-button:hover {
    filter: brightness(1.06);
  }

  .project-video__consent-button:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.45);
    outline-offset: 4px;
  }

  .project-video__consent-note {
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .project-video__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.15);
    list-style: none;
  }

  .project-video__facts li {
    min-height: 7rem;
    display: flex;
    align-items: center;
    padding: 1.5rem;
    background: #202020;
    font-weight: 750;
    line-height: 1.4;
  }

  .project-video__facts li::before {
    content: "✓";
    margin-right: 0.8rem;
    color: var(--color-primary, #971f25);
    font-weight: 900;
  }

  @media (max-width: 700px) {
    .project-video__facts {
      grid-template-columns: 1fr;
    }

    .project-video__facts li {
      min-height: 0;
    }

    .project-video__consent {
      padding: 1.25rem;
    }

    .project-video__consent-text {
      font-size: 0.95rem;
    }
  }
</style>
