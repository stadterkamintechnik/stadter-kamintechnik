    title: "Gebäude wurde verändert",
    text: "Aufstockungen, neue Dachformen oder Anbauten können die ursprünglichen Strömungsverhältnisse verändern. Dann muss die Mündungshöhe erneut technisch beurteilt werden.",
    image: "/images/kaminverlaengerung/gebaeude-veraendert.webp",
    alt: "Gebäude mit verändertem Dach und bestehendem Schornstein",
    position: "50% 46%",
  },
  {
    number: "03",
    title: "Störende Dach- und Windverhältnisse",
    text: "First, Gauben, Nachbargebäude oder ungünstige Windzonen können zu Rückströmungen und Druckschwankungen führen. Die richtige Mündungshöhe ist dann entscheidend.",
    image: "/images/kaminverlaengerung/windverhaeltnisse.webp",
    alt: "Schornsteinmündung im Einflussbereich von Dachfirst und Wind",
    position: "50% 44%",
  },
  {
    number: "04",
    title: "Neue Feuerstätte oder Heizung",
    text: "Nach einem Gerätewechsel können sich Abgasmenge, Temperatur und Förderdruck ändern. Die vorhandene Höhe muss deshalb zur neuen Feuerstätte passen.",
    image: "/images/kaminverlaengerung/neue-feuerstaette.webp",
    alt: "Neue Feuerstätte mit Anforderungen an den Schornsteinzug",
    position: "50% 50%",
  },
];

const systems = [
  {
    number: "01",
    name: "Doppelwandige Edelstahl-Kaminverlängerung",
    subtitle: "Die fachgerechte Lösung oberhalb des Daches",
    description:
      "Für die Verlängerung eines bestehenden Schornsteins setzen wir ein zugelassenes, gedämmtes und doppelwandiges Edelstahlsystem ein. Die Verlängerung wird über eine passende Edelstahlplatte sicher auf dem vorhandenen Kaminkopf befestigt. Höhe, Durchmesser und Befestigung werden für den jeweiligen Schornstein technisch geplant.",
    image: "/images/kaminverlaengerung/doppelwandige-verlaengerung.webp",
    alt: "Doppelwandige Edelstahl-Kaminverlängerung auf einem gemauerten Schornstein",
