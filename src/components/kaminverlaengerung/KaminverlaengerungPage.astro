      ["Planung", "Höhe und Standsicherheit werden geprüft"],
    ],
  },
];

const planning = [
  {
    number: "01",
    title: "Ursache klären",
    text: "Nicht jedes Zugproblem entsteht durch eine zu geringe Höhe. Wir prüfen zuerst Feuerstätte, Schornstein, Verbrennungsluft und die bauliche Umgebung.",
  },
  {
    number: "02",
    title: "Wirksame Höhe berechnen",
    text: "Die erforderliche Höhe wird nicht geschätzt. Querschnitt, Leistung, Abgastemperatur und Druckverhältnisse müssen zusammenpassen.",
  },
  {
    number: "03",
    title: "Mündung und Umgebung bewerten",
    text: "Dachfirst, Gauben, Nachbargebäude, Fenster und lokale Windverhältnisse beeinflussen die sichere Abgasabführung.",
  },
  {
    number: "04",
    title: "Befestigung und Standsicherheit planen",
    text: "Je größer die Verlängerung, desto wichtiger sind Montageplatte, Abspannung und die sichere Lastabtragung in den Bestand.",
  },
];

const process = [
  ["01", "Erstprüfung", "Wir klären Feuerstätte, Schornstein, Problem und vorhandene Unterlagen."],
  ["02", "Besichtigung", "Wir prüfen Kaminkopf, Dachumgebung, Zugänglichkeit und Befestigungsmöglichkeiten."],
  ["03", "Berechnung", "Wir bestimmen die technisch erforderliche Höhe und die passende Ausführung."],
  ["04", "Abstimmung", "Die Lösung wird bei Bedarf mit dem bevollmächtigten Bezirksschornsteinfeger abgestimmt."],
  ["05", "Angebot", "Sie erhalten ein transparentes Angebot mit klar beschriebenem Leistungsumfang."],
  ["06", "Montage", "Unsere eigenen Teams montieren die Verlängerung sicher und fachgerecht."],
];

const faqs = [
  {
    q: "Wann ist eine Kaminverlängerung sinnvoll?",
    a: "Eine Kaminverlängerung kann sinnvoll sein, wenn die wirksame Schornsteinhöhe für den benötigten Förderdruck nicht ausreicht, wenn sich durch Umbauten die Strömungsverhältnisse verändert haben oder wenn die Mündung in einem ungünstigen Wind- beziehungsweise Dachbereich liegt. Vorher muss geprüft werden, ob die Höhe tatsächlich die Ursache ist.",
  },
  {
    q: "Verbessert eine Kaminverlängerung immer den Zug?",
    a: "Eine größere wirksame Höhe kann den natürlichen Auftrieb verbessern. Sie hilft jedoch nur, wenn das Zugproblem tatsächlich mit der Höhe oder den Mündungsverhältnissen zusammenhängt. Falsche Querschnitte, fehlende Verbrennungsluft, Verschmutzungen oder technische Fehler an der Feuerstätte müssen separat betrachtet werden.",
  },
  {
    q: "Wie hoch muss ein Schornstein verlängert werden?",
    a: "Die erforderliche Höhe hängt von Feuerstätte, Leistung, Brennstoff, Schornsteinquerschnitt, wirksamer Höhe, Dachform und Umgebung ab. Eine pauschale Standardhöhe gibt es nicht. Die Verlängerung muss technisch berechnet und auf das konkrete Gebäude abgestimmt werden.",
  },
  {
    q: "Welche Arten von Kaminverlängerungen gibt es?",
    a: "Für die Verlängerung eines bestehenden Schornsteins wird ein zugelassenes, gedämmtes und doppelwandiges Edelstahlsystem verwendet. Entscheidend sind die richtige Dimensionierung, die passende Befestigung und die sichere Lastabtragung am vorhandenen Kaminkopf.",
  },
  {
    q: "Kann eine Kaminverlängerung auf jeden Schornstein gesetzt werden?",
    a: "Nein. Der Kaminkopf und die vorhandene Konstruktion müssen tragfähig sein. Außerdem müssen Querschnitt, System, Anschluss, Befestigung und Windlasten berücksichtigt werden. Bei einem geschädigten Kaminkopf kann zunächst eine Sanierung erforderlich sein.",
  },
  {
    q: "Ist eine Abspannung notwendig?",
    a: "Das hängt von Höhe, Durchmesser, System, Windlast und Befestigung am Bestand ab. Kürzere Verlängerungen können häufig direkt auf einer geeigneten Montageplatte befestigt werden. Größere freie Höhen benötigen gegebenenfalls zusätzliche Halterungen oder Abspannungen.",
  },
  {
    q: "Was kostet eine Kaminverlängerung?",
    a: "Die Kosten richten sich nach Höhe, Durchmesser, System, Befestigung, Dachzugang und Montageaufwand. Nach Prüfung des Bestands erhalten Sie ein nachvollziehbares Angebot mit der technisch erforderlichen Ausführung.",
  },
  {
    q: "Wann ist eine Schornsteinhöhenberechnung erforderlich?",
    a: "Eine rechnerische Bestimmung der erforderlichen Mündungshöhe kann notwendig sein, wenn eine Feuerungsanlage neu errichtet oder wesentlich geändert wird, sich die Gebäudesituation verändert hat oder ein entsprechender Nachweis verlangt wird. Je nach Anwendungsfall werden dabei die Vorgaben des § 19 der 1. BImSchV und die VDI 3781 Blatt 4 berücksichtigt. Ergibt die Berechnung eine größere erforderliche Höhe, kann eine fachgerecht geplante Kaminverlängerung die passende bauliche Lösung sein.",
  },
  {
    q: "Muss der Schornsteinfeger eingebunden werden?",
    a: "Ja, insbesondere wenn sich Mündungshöhe, Abgasführung oder Betriebsbedingungen ändern. Wir stimmen die geplante Ausführung frühzeitig mit dem bevollmächtigten Bezirksschornsteinfeger ab.",
  },
];
---

<div class="kv-page">
  <section class="kv-hero" aria-labelledby="kv-hero-title">
    <img class="kv-hero__image" src="/images/kaminverlaengerung/hero.webp" alt="Edelstahl-Kaminverlängerung auf einem bestehenden Schornstein" width="1664" height="936" loading="eager" fetchpriority="high" decoding="async" />
    <div class="kv-hero__overlay" aria-hidden="true"></div>
    <div class="container kv-hero__inner">
      <div class="kv-hero__content">
        <p class="kv-eyebrow kv-eyebrow--light">Kaminverlängerung vom Meisterbetrieb</p>
        <h1 id="kv-hero-title"><span>Zu wenig Zug oder zu geringe Höhe?</span> Wir bringen Ihren Schornstein auf die richtige Höhe.</h1>
        <p class="kv-hero__lead">Eine Kaminverlängerung kann Zugprobleme lösen und die sichere Abgasabführung verbessern. Wir prüfen die Ursache, berechnen die erforderliche Höhe und montieren die technisch passende Lösung.</p>
        <div class="kv-hero__actions">
          <a class="kv-button kv-button--primary" href="/projekt-starten/?projekt=kaminverlaengerung">Kaminverlängerung anfragen <span aria-hidden="true">→</span></a>
          <a class="kv-button kv-button--ghost" href="#systeme">Lösungen ansehen</a>
        </div>
        <ul class="kv-hero__facts" aria-label="Vertrauensmerkmale">
          <li><strong>Technisch geprüft</strong> statt pauschal erhöht</li>
          <li><strong>Eigene Teams</strong> keine Subunternehmer</li>
          <li><strong>Seit 2009</strong> Meisterbetrieb</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="kv-fit" aria-labelledby="kv-fit-title">
    <div class="container kv-fit__inner">
      <div><p class="kv-eyebrow">Schnelle Orientierung</p><h2 id="kv-fit-title">Wann sollte die Schornsteinhöhe geprüft werden?</h2></div>
      <ul class="kv-checklist">
        <li>Rauch tritt beim Anheizen oder Nachlegen aus.</li>
        <li>Die Feuerstätte erreicht keinen stabilen Zug.</li>
        <li>Das Gebäude oder die Dachlandschaft wurde verändert.</li>
        <li>Der Schornstein liegt ungünstig zu First, Gaube oder Nachbargebäude.</li>
      </ul>
    </div>
  </section>

  <section class="kv-section" aria-labelledby="kv-reasons-title">
    <div class="container">
      <div class="kv-intro kv-intro--wide"><p class="kv-eyebrow">Typische Situationen</p><h2 id="kv-reasons-title">Wann eine Kaminverlängerung infrage kommt.</h2><p>Eine Verlängerung ist keine pauschale Lösung für jedes Schornsteinproblem. Sie ist dann sinnvoll, wenn die wirksame Höhe oder die Lage der Mündung tatsächlich die Ursache ist.</p></div>
      <div class="kv-card-grid">
        {reasons.map((item) => (
          <article class="kv-info-card"><div class="kv-info-card__visual"><img src={item.image} alt={item.alt} width="900" height="675" loading="lazy" decoding="async" style={`object-position:${item.position};`} /></div><div class="kv-info-card__body"><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="kv-dark" aria-labelledby="kv-function-title">
    <div class="container kv-dark__inner">
      <div><p class="kv-eyebrow kv-eyebrow--light">Technik verstehen</p><h2 id="kv-function-title">Warum die wirksame Höhe den Schornsteinzug beeinflusst.</h2></div>
      <div class="kv-dark__copy"><p>Warme Abgase sind leichter als die kühlere Außenluft. Durch den Höhenunterschied zwischen Feuerstätte und Schornsteinmündung entsteht natürlicher Auftrieb. Dieser Unterdruck transportiert die Abgase sicher nach außen.</p><p>Ist die wirksame Höhe zu gering oder liegt die Mündung in einer ungünstigen Druckzone, kann der Förderdruck fehlen. Eine richtig dimensionierte Verlängerung verbessert dann die Strömungsverhältnisse – vorausgesetzt, Querschnitt, Feuerstätte und Verbrennungsluft passen ebenfalls.</p></div>
    </div>
  </section>

  <section id="systeme" class="kv-section kv-systems" aria-labelledby="kv-systems-title">
    <div class="container">
      <div class="kv-intro kv-intro--wide"><p class="kv-eyebrow">Ausführungen</p><h2 id="kv-systems-title">Die fachgerechte Lösung für den vorhandenen Schornstein.</h2><p>Entscheidend sind nicht verschiedene Bauarten, sondern die technisch richtige Dimensionierung und eine sichere Befestigung am vorhandenen Kaminkopf.</p></div>
      <div class="kv-system-grid">
        {systems.map((system) => (
          <article class="kv-system-card"><div class="kv-system-card__visual"><span>_{system.number}</span><img src={system.image} alt={system.alt} width="900" height="900" loading="lazy" decoding="async" /></div><div class="kv-system-card__content"><p class="kv-system-card__subtitle">{system.subtitle}</p><h3>{system.name}</h3><p class="kv-system-card__description">{system.description}</p><dl>{system.facts.map(([label,value]) => (<div><dt>{label}</dt><dd>{value}</dd></div>))}</dl></div></article>
        ))}
      </div>
      <aside class="kv-system-note"><div class="kv-system-note__label">Wichtig</div><div><h3>Die richtige Höhe muss berechnet werden.</h3><p>Eine Kaminverlängerung wird nur so hoch ausgeführt, wie es technisch erforderlich ist. Mit zunehmender Höhe steigen Windlasten und die Anforderungen an Befestigung und Standsicherheit. Deshalb planen wir jede Verlängerung passend zur Feuerstätte, zum Schornstein und zum Gebäude.</p></div></aside>
    </div>
  </section>

  <section class="kv-section kv-planning" aria-labelledby="kv-planning-title">
    <div class="container"><div class="kv-intro kv-intro--wide"><p class="kv-eyebrow">Sauber geplant</p><h2 id="kv-planning-title">Vier Punkte entscheiden über eine funktionierende Lösung.</h2><p>Die sichtbare Verlängerung ist nur das Ergebnis. Entscheidend sind vorher die technische Diagnose und eine sichere Planung.</p></div><div class="kv-planning-grid">{planning.map((item) => (<article><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div>
  </section>

  <section class="kv-standards" aria-labelledby="kv-standards-title">
    <div class="container kv-standards__inner">
      <div class="kv-standards__content">
        <p class="kv-eyebrow">Kaminverlängerung</p>
        <h2 id="kv-standards-title">Schornsteinhöhen- berechnung nach VDI 3781 Blatt 4 und 1. BImSchV.</h2>
        <p>
          Nicht jede erforderliche Schornsteinhöhe lässt sich allein anhand einer pauschalen
          Mindesthöhe bestimmen. Je nach Feuerungsanlage, Gebäudeform und Umgebung kann eine
          rechnerische Bestimmung der Mündungshöhe erforderlich sein.
        </p>
        <p>
          Bei Bedarf berücksichtigen wir die Vorgaben des § 19 der 1. BImSchV und der
          VDI 3781 Blatt 4. Ergibt die Berechnung, dass die vorhandene Austrittsöffnung zu niedrig
          liegt, planen wir eine technisch passende Kaminverlängerung.
        </p>
      </div>
      <div class="kv-standards__points">
        <article>
          <span>01</span>
          <h3>Gebäude und Umgebung erfassen</h3>
          <p>Dachform, First, Nachbargebäude sowie Fenster und Lüftungsöffnungen werden berücksichtigt.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Berechnung durchführen</h3>
          <p>Wir führen die Schornsteinhöhenberechnung nach VDI 3781 Blatt 4 und den Vorgaben der 1. BImSchV fachgerecht durch.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Erforderliche Mündungshöhe bestimmen</h3>
          <p>Die notwendige Austrittshöhe wird anhand der für den Anwendungsfall maßgeblichen Vorgaben ermittelt.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Kaminverlängerung planen</h3>
          <p>Aus dem Berechnungsergebnis leiten wir Höhe, Ausführung, Befestigung und Standsicherheit der Verlängerung ab.</p>
        </article>
        <article>
          <span>05</span>
          <h3>Fachgerechte Montage</h3>
          <p>Unsere eigenen Montageteams setzen die geplante Kaminverlängerung fachgerecht um und sorgen für eine sichere, langlebige Lösung.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="kv-project" aria-labelledby="kv-project-title">
    <div class="container kv-project__inner"><div class="kv-project__image"><img src="/images/kaminverlaengerung/referenz.webp" alt="Fertig montierte Kaminverlängerung aus Edelstahl" width="1200" height="900" loading="lazy" decoding="async" /></div><div class="kv-project__content"><p class="kv-eyebrow">Fachgerecht umgesetzt</p><h2 id="kv-project-title">Sicher befestigt. Passend dimensioniert. Dauerhaft funktional.</h2><p>Wir betrachten die Kaminverlängerung nicht als einzelnes Bauteil, sondern als Teil der gesamten Abgasanlage. So entstehen Lösungen, die technisch funktionieren, sicher montiert sind und optisch zum Gebäude passen.</p><ul><li>passendes zugelassenes System</li><li>stabile Montage am vorhandenen Kaminkopf</li><li>Berücksichtigung von Windlast und Dachzugang</li><li>Abstimmung mit dem Schornsteinfeger</li></ul></div></div>
  </section>

  <section class="kv-section kv-process" aria-labelledby="kv-process-title"><div class="container"><div class="kv-intro"><p class="kv-eyebrow">Klarer Ablauf</p><h2 id="kv-process-title">Von der Zugprüfung bis zur Montage.</h2></div><ol>{process.map(([number,title,text]) => (<li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>))}</ol></div></section>

  <section class="kv-proof" aria-labelledby="kv-proof-title"><div class="container kv-proof__inner"><div><p class="kv-eyebrow kv-eyebrow--light">Warum Stadter?</p><h2 id="kv-proof-title">Prüfen. Berechnen. Sicher montieren.</h2></div><div class="kv-proof__grid"><div><strong>Seit 2009</strong><span>Schornstein- und Abgastechnik</span></div><div><strong>10.000+</strong><span>realisierte Projekte</span></div><div><strong>Meisterbetrieb</strong><span>technische Planung mit Verantwortung</span></div><div><strong>Eigene Teams</strong><span>Montage durch erfahrene Fachkräfte</span></div></div></div></section>

  <section class="kv-section kv-faq" aria-labelledby="kv-faq-title"><div class="container kv-faq__inner"><div class="kv-intro"><p class="kv-eyebrow">Gut zu wissen</p><h2 id="kv-faq-title">Häufige Fragen zur Kaminverlängerung.</h2></div><div class="kv-faq__list">{faqs.map((faq,index) => (<details open={index === 0}><summary><span>{faq.q}</span><span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>))}</div></div></section>

  <section class="kv-cta" aria-labelledby="kv-cta-title"><div class="container kv-cta__inner"><div><p class="kv-eyebrow kv-eyebrow--light">Ihr nächster Schritt</p><h2 id="kv-cta-title">Lassen Sie prüfen, ob eine Kaminverlängerung Ihr Problem löst.</h2><p>Senden Sie uns Fotos, Angaben zur Feuerstätte und Informationen zum Gebäude. Unser Projektteam prüft Ihr Vorhaben persönlich.</p></div><div class="kv-cta__actions"><a class="kv-button kv-button--white" href="/projekt-starten/?projekt=kaminverlaengerung">Kaminverlängerung anfragen <span aria-hidden="true">→</span></a><a class="kv-cta__phone" href="tel:+4992289989000">09228 998900-0</a></div></div></section>
</div>

